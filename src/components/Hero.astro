---
// Hero section — diseño aprobado en Fase 2, Híbrido A+B
// Globe.GL + Three.js + estrellas + liquid glass + nav
---

<!-- Capas de fondo -->
<canvas id="space"></canvas>
<div id="globe-stage"></div>

<!-- Filtro SVG liquid glass (referenciado por backdrop-filter url()) -->
<svg class="defs" aria-hidden="true" width="0" height="0">
  <filter id="liquidGlass" x="-25%" y="-25%" width="150%" height="150%">
    <feTurbulence type="fractalNoise" baseFrequency="0.011 0.015" numOctaves="2" seed="7" result="n">
      <animate attributeName="baseFrequency" dur="16s" values="0.011 0.015;0.017 0.009;0.011 0.015" repeatCount="indefinite"/>
    </feTurbulence>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="16" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>

<!-- Nav -->
<header id="hdr">
  <nav class="nav">
    <div class="brand"><a href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;"><img src="/logo-white.svg" alt="Decentralize" class="brand-logo" /></a></div>
    <ul class="nav-links">
      <li><a href="#masterclass">El Masterclass</a></li>
      <li><a href="#comunidad">Comunidad</a></li>
      <li><a href="#alberto">Alberto</a></li>
      <li><a href="#testimonios">Testimonios</a></li>
    </ul>
    <a href="#form" class="btn btn-glass btn-primary btn-sm btn-hero">
      <span class="liquid"></span>
      <span class="t"><span class="txt-desktop">Empezá ahora</span><span class="txt-mobile">Empezá Ya</span></span>
    </a>
    <button id="hamburger" class="btn btn-glass btn-primary btn-sm btn-hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu">
      <span class="liquid"></span><span class="t">☰</span>
    </button>
  </nav>
</header>
<nav id="nav-menu" aria-label="Menú móvil">
  <a href="#masterclass">El Masterclass</a>
  <a href="#comunidad">Comunidad</a>
  <a href="#alberto">Alberto</a>
  <a href="#testimonios">Testimonios</a>
</nav>

<!-- Hero -->
<main>
  <section class="hero">
    <div class="text-block">
      <h1>
        <span class="reveal"><span>Tu dinero pierde valor cada día.</span></span>
        <span class="reveal line-orange"><span>Bitcoin es la salida que nadie te explicó.</span></span>
      </h1>
      <p class="sub">Trabajás duro, ahorrás y cada año alcanza menos. No es casualidad, es el sistema funcionando como fue diseñado. Nadie te enseñó cómo funciona el dinero de verdad. Acá lo aprendés en 7 horas.</p>
    </div>

    <div class="vsl" id="vsl">
      <div class="pp">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 3v18l15-9z"/></svg>
      </div>
      <span class="vlabel">VSL · 7 min</span>
    </div>

    <div class="cta-row">
      <a href="#form" class="btn btn-glass btn-primary btn-hero">
        <span class="liquid"></span>
        <span class="t">Unirme al Bitcoin Masterclass</span>
      </a>
    </div>

    <div class="stats">
      <div class="stat">
        <span class="corner tl"></span><span class="corner br"></span><span class="sat-led"></span>
        <div class="num"><span class="pre">+</span><span data-count="9000">0</span></div>
        <div class="lbl">horas de estudio condensadas</div>
      </div>
      <div class="stat">
        <span class="corner tl"></span><span class="corner br"></span><span class="sat-led"></span>
        <div class="num"><span data-count="7">0</span></div>
        <div class="lbl">horas de contenido claro</div>
      </div>
      <div class="stat">
        <span class="corner tl"></span><span class="corner br"></span><span class="sat-led"></span>
        <div class="num"><span data-count="1">0</span></div>
        <div class="lbl">solo pago, acceso de por vida</div>
      </div>
    </div>
  </section>
</main>

<!-- Indicador de scroll -->
<div class="scroll-ind" id="scrollInd">
  <div class="mouse"><span class="wheel"></span></div>
  <span class="arrow">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </span>
  <span class="lbl">scroll</span>
</div>

<style is:global>
  /* ---- Variables del hero (sobrescriben tokens globales donde difieren) ---- */
  :root {
    --gold:        #C99A4B;
    --gold-soft:   #E6C079;
    --ember:       #F7931A;
    --border:      rgba(255,255,255,0.10);
    --border-warm: rgba(247,147,26,0.24);
    --maxw:        1240px;
  }

  /* ---- Capas de fondo ---- */
  #space          { position:fixed;inset:0;z-index:0;pointer-events:none }
  #globe-stage    { position:fixed;inset:0;z-index:1;user-select:none;-webkit-user-select:none }
  #globe-stage canvas { position:absolute;inset:0;width:100%!important;height:100%!important }
  .defs           { position:absolute;width:0;height:0;overflow:hidden }

  /* ---- Nav ---- */
  header { position:fixed;top:0;left:0;right:0;z-index:50;transition:background .4s,border-color .4s,backdrop-filter .4s;border-bottom:1px solid transparent }
  header.scrolled { background:rgba(0,0,0,0.55);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);border-bottom:1px solid var(--border) }
  .nav { max-width:var(--maxw);margin:0 auto;padding:20px clamp(22px,4vw,44px);display:flex;align-items:center;justify-content:space-between;gap:24px }
  .brand { display:flex;align-items:center }
  .brand-logo { height:48px;width:auto;display:block }
  @media(max-width:900px) { .brand-logo { height:42px } }
  .nav-links { display:flex;gap:30px;list-style:none }
  .nav-links a { color:var(--muted);text-decoration:none;font-size:14.5px;font-weight:450;transition:color .25s;position:relative;text-shadow:0 1px 10px rgba(0,0,0,.6) }
  .nav-links a:hover { color:var(--text-bright) }
  .nav-links a::after { content:"";position:absolute;left:0;bottom:-6px;height:1px;width:0;background:var(--gold);transition:width .3s }
  .nav-links a:hover::after { width:100% }
  .txt-mobile { display:none }
  .btn-hamburger { display:none;align-items:center;justify-content:center;width:38px;height:38px;padding:0;border-radius:10px;font-size:18px;line-height:1;flex-shrink:0 }
  @media(max-width:900px) {
    .nav-links { display:none }
    .txt-desktop { display:none }
    .txt-mobile { display:inline }
    .btn-hamburger { display:inline-flex }
    .nav .btn-hero { font-size:12px;padding:6px 12px;white-space:nowrap }
  }
  #nav-menu { position:fixed;top:68px;right:clamp(16px,4vw,44px);min-width:200px;background:rgba(10,10,10,0.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(247,147,26,0.3);border-radius:12px;overflow:hidden;z-index:100;transform:translateY(-10px);opacity:0;pointer-events:none;transition:opacity .25s ease,transform .25s ease }
  #nav-menu.open { opacity:1;transform:translateY(0);pointer-events:auto }
  #nav-menu a { display:block;padding:14px 20px;color:#fff;text-decoration:none;font-size:15px;font-weight:500;border-bottom:1px solid rgba(255,255,255,0.06);transition:color .2s }
  #nav-menu a:last-child { border-bottom:none }
  #nav-menu a:hover { color:#F7931A }

  /* ---- Botones ---- */
  .btn { font-family:var(--font-sans);font-size:15px;font-weight:550;border:none;cursor:pointer;text-decoration:none;padding:13px 22px;border-radius:14px;display:inline-flex;align-items:center;gap:9px;transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .3s,background .3s,border-color .3s;will-change:transform }
  .btn-sm { padding:10px 18px;font-size:14px;border-radius:12px }
  .btn-glass { position:relative;overflow:hidden;color:var(--text-bright);background:rgba(255,255,255,0.06);border:1px solid var(--border);-webkit-backdrop-filter:blur(7px) saturate(160%);backdrop-filter:blur(7px) saturate(160%) url(#liquidGlass);box-shadow:inset 0 1px 0 rgba(255,255,255,.40),inset 0 -10px 18px -10px rgba(0,0,0,.55),inset 0 0 16px rgba(255,255,255,.05),0 12px 32px -14px rgba(0,0,0,.8) }
  .btn-glass .t, .btn-glass .play { position:relative;z-index:3 }
  .btn-glass::before { content:"";position:absolute;inset:0;border-radius:inherit;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.30),rgba(255,255,255,0) 44%) }
  .btn-glass .liquid { position:absolute;left:var(--mx,50%);top:var(--my,50%);width:130px;height:130px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(255,255,255,.55),rgba(255,255,255,0) 60%);filter:blur(8px);opacity:0;transition:opacity .35s;pointer-events:none;z-index:2;mix-blend-mode:screen }
  .btn-glass:hover .liquid { opacity:.9 }
  .btn-glass:hover { transform:translateY(-2px) }
  .btn-glass.btn-primary { border-color:var(--border-warm);color:#FFFFFF;text-shadow:0 0 12px rgba(255,255,255,0.4);background:rgba(247,147,26,0.10);box-shadow:inset 0 1px 0 rgba(255,255,255,.45),inset 0 0 22px rgba(247,147,26,.18),0 0 24px -4px rgba(247,147,26,.45),0 14px 38px -14px rgba(247,147,26,.55) }
  .btn-glass.btn-primary:hover { border-color:rgba(247,147,26,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.55),inset 0 0 28px rgba(247,147,26,.26),0 0 34px -2px rgba(247,147,26,.6),0 18px 46px -14px rgba(247,147,26,.6) }
  @keyframes btnBreathe { 0%{box-shadow:0 0 10px rgba(247,147,26,0.3),0 0 20px rgba(247,147,26,0.1)} 100%{box-shadow:0 0 25px rgba(247,147,26,0.8),0 0 50px rgba(247,147,26,0.4)} }
  .btn-glass.btn-primary.btn-hero { background:rgba(247,147,26,0.15);border:1.5px solid #F7931A;border-radius:999px;color:#FFFFFF;font-weight:600;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);animation:btnBreathe 2.5s ease-in-out infinite alternate }
  .btn-glass.btn-primary.btn-hero:hover { background:rgba(247,147,26,0.22);border-color:#F7931A }

  /* ---- Hero layout ---- */
  main { position:relative;z-index:2;pointer-events:none }
  .hero { max-width:var(--maxw);margin:0 auto;padding:20px 24px 40px;min-height:100dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;pointer-events:none }
  .hero > * { pointer-events:none }
  .text-block { display:block;width:100%;max-width:760px;padding:56px 40px 0!important;margin-left:auto;margin-right:auto;text-align:center;background:radial-gradient(ellipse at center,rgba(0,0,0,0.72) 0%,rgba(0,0,0,0) 75%);pointer-events:none }

  /* ---- Título ---- */
  h1 { font-family:var(--font-display);font-weight:700;font-size:clamp(1.8rem,4vw,3.2rem);line-height:1.05;letter-spacing:-.02em;max-width:17ch;margin-left:auto;margin-right:auto;margin-bottom:18px;color:var(--text-bright) }
  h1 .reveal { display:block }
  h1 .reveal > span { display:block;color:#FFFFFF;text-shadow:0 0 6px rgba(0,0,0,1),0 0 15px rgba(0,0,0,1),0 2px 4px rgba(0,0,0,1),2px 2px 0 rgba(0,0,0,0.9),-2px -2px 0 rgba(0,0,0,0.9),1px -1px 0 rgba(0,0,0,0.9),-1px 1px 0 rgba(0,0,0,0.9) }
  h1 .reveal.line-orange > span { background:linear-gradient(135deg,#F7931A 0%,#FFB347 40%,#F7931A 70%,#CC7A00 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;text-shadow:none;filter:drop-shadow(0 0 8px rgba(0,0,0,1)) drop-shadow(0 2px 4px rgba(0,0,0,1)) }

  /* ---- Subtítulo ---- */
  .sub { font-family:var(--font-sans);font-size:clamp(0.85rem,1.5vw,1rem);color:rgba(255,255,255,0.75);max-width:34em;margin-left:auto;margin-right:auto;margin-bottom:0;text-shadow:0 0 4px rgba(0,0,0,1),0 0 8px rgba(0,0,0,1),0 0 16px rgba(0,0,0,1),0 0 30px rgba(0,0,0,1),2px 2px 0 rgba(0,0,0,1),-2px -2px 0 rgba(0,0,0,1),1px -1px 0 rgba(0,0,0,1),-1px 1px 0 rgba(0,0,0,1) }

  /* ---- VSL placeholder ---- */
  .vsl { position:relative;width:min(560px,84vw);aspect-ratio:16/9;border-radius:18px;overflow:hidden;margin:3px auto 0;z-index:3;cursor:pointer;pointer-events:auto;border:1px solid rgba(255,255,255,.18);background:linear-gradient(180deg,rgba(8,11,18,.80),rgba(4,6,12,.85));-webkit-backdrop-filter:blur(5px) saturate(135%);backdrop-filter:blur(5px) saturate(135%);box-shadow:0 34px 90px -34px rgba(0,0,0,.92),0 0 0 1px rgba(247,147,26,.14),0 0 70px -10px rgba(247,147,26,.22);display:grid;place-items:center;transition:transform .3s,box-shadow .3s }
  .vsl:hover { transform:scale(1.015);box-shadow:0 40px 100px -34px rgba(0,0,0,.95),0 0 0 1px rgba(247,147,26,.24),0 0 84px -8px rgba(247,147,26,.34) }
  .vsl .pp { width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:rgba(247,147,26,0.18);border:1px solid rgba(247,147,26,.55);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);box-shadow:0 0 32px -4px rgba(247,147,26,.65),inset 0 1px 0 rgba(255,255,255,.45) }
  .vsl .pp svg { width:25px;height:25px;margin-left:3px;color:#FFE9CC }
  .vsl .vlabel { position:absolute;bottom:12px;left:14px;font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#cfd6e2 }

  /* ---- CTA row ---- */
  .cta-row { display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin:32px 0 30px;pointer-events:none }
  .cta-row .btn { pointer-events:auto }

  /* ---- Stats satélite ---- */
  .stats { display:flex;flex-direction:row;flex-wrap:nowrap;gap:14px;justify-content:center;max-width:min(560px,90vw);margin-left:auto;margin-right:auto }
  .stat { position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;flex:1;min-width:0;padding:14px 16px 12px;border-radius:14px;pointer-events:auto;background:linear-gradient(180deg,rgba(14,18,27,.60),rgba(6,9,15,.72));border:1px solid rgba(255,255,255,.10);box-shadow:inset 0 1px 0 rgba(255,255,255,.07),inset 0 0 24px rgba(247,147,26,.05),0 0 0 1px rgba(247,147,26,.07),0 22px 44px -26px rgba(0,0,0,.92);-webkit-backdrop-filter:blur(7px) saturate(130%);backdrop-filter:blur(7px) saturate(130%);animation:orbit var(--dur,6s) ease-in-out var(--del,0s) infinite;will-change:transform;transition:box-shadow 0.3s ease,border-color 0.3s ease }
  .stat:hover { border-color:rgba(247,147,26,0.8);box-shadow:0 0 16px rgba(247,147,26,0.5),0 0 32px rgba(247,147,26,0.2) }
  .stat::after { content:"";position:absolute;top:-1px;left:22%;right:22%;height:1px;border-radius:2px;background:linear-gradient(90deg,transparent,rgba(247,147,26,.55),transparent) }
  .stat .corner { position:absolute;width:11px;height:11px;border:1px solid rgba(247,147,26,.45) }
  .stat .corner.tl { top:8px;left:8px;border-right:none;border-bottom:none;border-top-left-radius:3px }
  .stat .corner.br { bottom:8px;right:8px;border-left:none;border-top:none;border-bottom-right-radius:3px }
  .stat .sat-led { position:absolute;top:11px;right:12px;width:6px;height:6px;border-radius:50%;background:var(--ember);box-shadow:0 0 8px 1px rgba(247,147,26,.75);animation:led 2.6s ease-in-out infinite }
  .stat .num { font-family:var(--font-display);font-weight:700;font-size:clamp(1.52rem,2.4vw,2rem);line-height:1;color:var(--text-bright);letter-spacing:-.02em;font-variant-numeric:tabular-nums;text-shadow:0 2px 16px rgba(0,0,0,.85) }
  .stat .num .pre { color:var(--gold-soft) }
  .stat .lbl { font-family:var(--font-mono);font-size:11px;letter-spacing:.04em;color:#AEB8C6;text-align:center }
  .stat:nth-child(1) { --dur:6.6s;--del:0s }
  .stat:nth-child(2) { --dur:5.4s;--del:-1.8s }
  .stat:nth-child(3) { --dur:7.4s;--del:-3.4s }
  @keyframes orbit { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
  @keyframes led   { 0%,100%{opacity:1} 50%{opacity:.25} }

  /* ---- Scroll indicator ---- */
  .scroll-ind { position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:4;display:flex;flex-direction:column;align-items:center;gap:7px;pointer-events:none;opacity:.85;transition:opacity .4s }
  .scroll-ind.hide { opacity:0 }
  .scroll-ind .lbl { font-family:var(--font-mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:#9aa6b6;text-shadow:0 1px 10px rgba(0,0,0,.8) }
  .scroll-ind .mouse { width:22px;height:34px;border:1.5px solid rgba(255,255,255,.45);border-radius:12px;display:flex;justify-content:center;padding-top:6px }
  .scroll-ind .wheel { width:3px;height:7px;border-radius:3px;background:var(--gold-soft);box-shadow:0 0 8px rgba(247,147,26,.7);animation:wheel 1.7s ease-in-out infinite }
  .scroll-ind .arrow { color:rgba(255,255,255,.5);animation:bounce 1.7s ease-in-out infinite }
  .scroll-ind .arrow svg { width:14px;height:14px }
  @keyframes wheel  { 0%{opacity:0;transform:translateY(-3px)} 40%{opacity:1} 80%,100%{opacity:0;transform:translateY(7px)} }
  @keyframes bounce { 0%,100%{transform:translateY(0);opacity:.5} 50%{transform:translateY(5px);opacity:1} }

  /* ---- Responsive móvil ---- */
  @media(max-width:768px) {
    .text-block { max-width:98vw;padding:56px 8px 0!important }
    h1 { font-size:clamp(1.6rem,7vw,2rem);line-height:1.15;max-width:none }
    .sub { max-width:95vw }
    .vsl { margin-top:1px }
    .stat { padding:8px 16px 7px }
  }
  @media(prefers-reduced-motion:reduce) {
    * { animation:none!important;transition:none!important }
    html { scroll-behavior:auto }
  }
</style>

<!-- CDN: Globe.GL + GSAP (is:inline = Astro no los procesa, el browser los ejecuta) -->
<script is:inline src="//cdn.jsdelivr.net/npm/globe.gl"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<!-- Animaciones GSAP + contadores + liquid glass + estrellas/cometas -->
<script is:inline>
(function () {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hdr = document.getElementById('hdr');
  const scrollInd = document.getElementById('scrollInd');

  /* Scroll header + scroll indicator */
  const onScroll = () => {
    hdr.classList.toggle('scrolled', window.scrollY > 12);
    scrollInd.classList.toggle('hide', window.scrollY > 40);
  };
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  /* Globo visible mientras hero O problema estén en el viewport */
  const spaceEl  = document.getElementById('space');
  const stageEl  = document.getElementById('globe-stage');
  if (spaceEl && stageEl) {
    const globeVisible = new Set();
    const syncGlobe = () => {
      stageEl.style.opacity = globeVisible.size > 0 ? '1' : '0';
    };
    const globeObs = new IntersectionObserver(entries => {
      entries.forEach(e => e.isIntersecting
        ? globeVisible.add(e.target)
        : globeVisible.delete(e.target));
      syncGlobe();
    }, { threshold: 0 });
    const heroMain = document.querySelector('main');
    if (heroMain) globeObs.observe(heroMain);
    // #problema se renderiza después de este script — esperar a que el DOM esté completo
    document.addEventListener('DOMContentLoaded', () => {
      const problemaEl = document.getElementById('problema');
      if (problemaEl) globeObs.observe(problemaEl);
    });
  }

  /* Entrada con GSAP */
  if (!reduce && window.gsap) {
    gsap.set('.reveal > span', { y: '1.05em', opacity: 0 });
    gsap.timeline({ defaults: { ease: 'power3.out' } })
      .to('.reveal > span', { y: 0, opacity: 1, duration: .9, stagger: .12 }, .15)
      .from('.sub',        { y: 16, opacity: 0, duration: .7 }, .55)
      .from('.vsl',        { y: 24, opacity: 0, duration: .9, ease: 'power2.out' }, .7)
      .from('.cta-row',    { y: 16, opacity: 0, duration: .7 }, .9)
      .from('.stat',       { y: 18, opacity: 0, duration: .7, stagger: .1 }, 1.0)
      .from('.scroll-ind', { opacity: 0, duration: .8 }, 1.3);
  }

  /* Contadores animados */
  const fmt = n => n.toLocaleString('es-CR');
  document.querySelectorAll('[data-count]').forEach(el => {
    const target = +el.dataset.count;
    if (reduce || !window.gsap) { el.textContent = fmt(target); return; }
    const o = { v: 0 };
    gsap.to(o, { v: target, duration: 1.8, delay: 1.1, ease: 'power2.out',
      onUpdate: () => el.textContent = fmt(Math.round(o.v)) });
  });

  /* Liquid glass: efecto blob al mover el puntero */
  document.querySelectorAll('.btn-glass').forEach(btn => {
    btn.addEventListener('pointermove', e => {
      const r = btn.getBoundingClientRect();
      btn.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      btn.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });

  /* Estrellas pulsantes + cometas */
  (function () {
    const cv = document.getElementById('space');
    const x  = cv.getContext('2d');
    let W, H, DPR, stars, shoots, nextShoot = 0;

    function init() {
      DPR = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      cv.width  = W * DPR; cv.height = H * DPR;
      cv.style.width = W + 'px'; cv.style.height = H + 'px';
      x.setTransform(DPR, 0, 0, DPR, 0, 0);
      stars = [];
      const n = Math.round(W * H / 8000);
      for (let i = 0; i < n; i++)
        stars.push({ x: Math.random() * W, y: Math.random() * H,
          r: Math.random() * 1.3 + 0.3,
          base: 0.15 + Math.random() * 0.35,
          amp:  0.35 + Math.random() * 0.5,
          sp:   0.4  + Math.random() * 1.4,
          ph:   Math.random() * 6.28 });
      shoots = [];
    }

    function spawnShoot() {
      const fromLeft = Math.random() < 0.5;
      const ang = (22 + Math.random() * 16) * Math.PI / 180;
      const sp  = 8 + Math.random() * 5;
      shoots.push({ x: fromLeft ? -40 : W + 40, y: Math.random() * H * 0.5,
        vx: (fromLeft ? 1 : -1) * sp * Math.cos(ang), vy: sp * Math.sin(ang),
        len: 90 + Math.random() * 80 });
    }

    function draw(t) {
      x.clearRect(0, 0, W, H);
      for (const s of stars) {
        const a = reduce ? 0.55 : s.base + s.amp * (0.5 + 0.5 * Math.sin(t * 0.001 * s.sp + s.ph));
        x.globalAlpha = Math.max(0, Math.min(1, a)) * 0.9;
        x.fillStyle = '#dfe6f2';
        x.beginPath(); x.arc(s.x, s.y, s.r, 0, 6.2832); x.fill();
      }
      x.globalAlpha = 1;
      if (!reduce) {
        if (t > nextShoot) { spawnShoot(); nextShoot = t + 4000 + Math.random() * 4000; }
        for (let i = shoots.length - 1; i >= 0; i--) {
          const s = shoots[i]; s.x += s.vx; s.y += s.vy;
          const m = Math.hypot(s.vx, s.vy);
          const tx = s.x - s.vx / m * s.len, ty = s.y - s.vy / m * s.len;
          const g = x.createLinearGradient(s.x, s.y, tx, ty);
          g.addColorStop(0, 'rgba(255,255,255,0.95)');
          g.addColorStop(0.3, 'rgba(214,226,245,0.5)');
          g.addColorStop(1, 'rgba(214,226,245,0)');
          x.strokeStyle = g; x.lineWidth = 1.6;
          x.beginPath(); x.moveTo(s.x, s.y); x.lineTo(tx, ty); x.stroke();
          x.globalAlpha = 0.9; x.fillStyle = '#fff';
          x.beginPath(); x.arc(s.x, s.y, 1.5, 0, 6.2832); x.fill();
          x.globalAlpha = 1;
          if (s.x < -60 || s.x > W + 60 || s.y > H + 60) shoots.splice(i, 1);
        }
      }
      if (!reduce) requestAnimationFrame(draw);
    }

    init();
    addEventListener('resize', init);
    requestAnimationFrame(draw);
  })();
})();
</script>

<!-- Globe.GL + Three.js: planeta, nodos Bitcoin, arcos, ₿ viajando -->
<script type="module" is:inline>
  import * as THREE from 'https://esm.sh/three@0.170.0';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage  = document.getElementById('globe-stage');

  /* Nodos Bitcoin */
  const hubs = [
    {lat:40.7,lng:-74.0},{lat:34.0,lng:-118.2,pac:1},{lat:19.4,lng:-99.1},{lat:37.8,lng:-122.4,pac:1},
    {lat:9.9,lng:-84.1},{lat:-12.0,lng:-77.0,pac:1},{lat:-23.5,lng:-46.6},{lat:-34.6,lng:-58.4},
    {lat:51.5,lng:-0.1},{lat:48.9,lng:2.35},{lat:40.4,lng:-3.7},{lat:55.75,lng:37.6},
    {lat:6.5,lng:3.4},{lat:30.0,lng:31.2},{lat:-26.2,lng:28.0},{lat:-1.3,lng:36.8},
    {lat:25.2,lng:55.3},{lat:41.0,lng:28.98},{lat:43.2,lng:76.9},
    {lat:19.1,lng:72.9},{lat:1.35,lng:103.8,pac:1},
    {lat:22.3,lng:114.2,pac:1},{lat:31.2,lng:121.5,pac:1},{lat:35.7,lng:139.7,pac:1},
    {lat:-6.2,lng:106.8,pac:1},{lat:21.3,lng:-157.8,pac:1},{lat:-33.9,lng:151.2,pac:1},{lat:-36.8,lng:174.7,pac:1},
    {lat:-27.5,lng:153.0,pac:1},{lat:-37.8,lng:145.0,pac:1},
    {lat:-6.8,lng:39.3},{lat:5.6,lng:-0.2},{lat:41.3,lng:69.2},
    {lat:59.9,lng:10.75},{lat:59.3,lng:18.1},{lat:23.1,lng:-82.4},{lat:18.5,lng:-69.9},
    {lat:-31.95,lng:115.86,pac:1},
    {lat:-4.3,lng:15.3},{lat:9.0,lng:38.7},{lat:33.6,lng:-7.6},
    {lat:51.1,lng:71.4},{lat:6.9,lng:79.9},{lat:31.5,lng:74.3},
    {lat:60.2,lng:24.9},{lat:55.7,lng:12.6},
    {lat:18.0,lng:-76.8},{lat:10.7,lng:-61.5}
  ];

  /* Arcos */
  const pac = hubs.map((h, i) => h.pac ? i : -1).filter(i => i >= 0);
  const arcs = [];
  const mkArc = (a, b) => arcs.push({ startLat: hubs[a].lat, startLng: hubs[a].lng, endLat: hubs[b].lat, endLng: hubs[b].lng });
  const ri = () => (Math.random() * hubs.length) | 0;
  for (let i = 0; i < 8; i++) { let a = ri(), b = ri(); if (b === a) b = (b + 1) % hubs.length; mkArc(a, b); }

  const afr = [12,13,14,15,30,31,38,39,40];
  const eur = [8,9,10,11,17,33,34,44,45];
  const asi = [16,18,19,32,41,42,43];
  const addRegion = (pool, n) => {
    for (let i = 0; i < n; i++) {
      let a = pool[(Math.random() * pool.length) | 0], b = pool[(Math.random() * pool.length) | 0];
      if (b === a) b = pool[(pool.indexOf(a) + 1) % pool.length];
      mkArc(a, b);
    }
  };
  addRegion(afr, 3); addRegion(eur, 3); addRegion(asi, 3);

  const pacArcStart = arcs.length;
  const rp = () => pac[(Math.random() * pac.length) | 0];
  for (let i = 0; i < 4; i++) { let a = rp(), b = rp(); if (b === a) b = pac[(pac.indexOf(a) + 1) % pac.length]; mkArc(a, b); }
  const pacArcIdx = [];
  for (let i = pacArcStart; i < arcs.length; i++) pacArcIdx.push(i);

  /* Textura glow nodos */
  function makeGlowTex() {
    const c = document.createElement('canvas'); c.width = c.height = 64;
    const g = c.getContext('2d');
    const rg = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    rg.addColorStop(0,    'rgba(255,220,120,0.9)');
    rg.addColorStop(0.35, 'rgba(247,147,26,0.55)');
    rg.addColorStop(1,    'rgba(247,147,26,0)');
    g.fillStyle = rg; g.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(c);
  }
  const glowTex = makeGlowTex();

  /* Globe.GL */
  const world = new Globe(stage, { animateIn: false })
    .backgroundColor('rgba(0,0,0,0)')
    .globeImageUrl('//cdn.jsdelivr.net/npm/three-globe/example/img/earth-blue-marble.jpg')
    .bumpImageUrl('//cdn.jsdelivr.net/npm/three-globe/example/img/earth-topology.png')
    .showAtmosphere(true)
    .atmosphereColor('#00E5FF')
    .atmosphereAltitude(0.162)
    .customLayerData(hubs)
    .customThreeObject(() => {
      const group = new THREE.Group();
      const glow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: glowTex, transparent: true,
        blending: THREE.AdditiveBlending, depthWrite: false, depthTest: true
      }));
      glow.scale.set(6, 6, 1); glow.renderOrder = 1;
      group.add(glow);
      const core = new THREE.Mesh(
        new THREE.SphereGeometry(0.9, 12, 12),
        new THREE.MeshBasicMaterial({ color: 0xF7931A, depthWrite: true, depthTest: true })
      );
      core.renderOrder = 2; group.add(core);
      return group;
    })
    .customThreeObjectUpdate((obj, d) => {
      Object.assign(obj.position, world.getCoords(d.lat, d.lng, 0.02));
    })
    .arcsData(arcs)
    .arcColor(() => ['rgba(247,147,26,0)', 'rgba(247,175,80,0.92)'])
    .arcStroke(0.42)
    .arcAltitudeAutoScale(0.5)
    .arcDashLength(0.4)
    .arcDashGap(1.6)
    .arcDashInitialGap(() => Math.random() * 5)
    .arcDashAnimateTime(2600);

  function updateGlobeView() {
    world.pointOfView({ altitude: window.innerWidth <= 768 ? 2.8 : 1.8 });
  }
  updateGlobeView();
  world.renderer().setClearAlpha(0);
  world.controls().autoRotate      = !reduce;
  world.controls().autoRotateSpeed = 0.35;
  world.controls().enableZoom      = false;
  world.controls().noZoom          = true;

  window.addEventListener('resize', () => {
    world.width(window.innerWidth).height(window.innerHeight);
    updateGlobeView();
  });

  /* Nubes */
  const CLOUDS_URL = 'https://raw.githubusercontent.com/vasturiano/globe.gl/master/example/clouds/clouds.png';
  new THREE.TextureLoader().load(CLOUDS_URL, tex => {
    const clouds = new THREE.Mesh(
      new THREE.SphereGeometry(world.getGlobeRadius() * 1.004, 75, 75),
      new THREE.MeshPhongMaterial({ map: tex, transparent: true })
    );
    world.scene().add(clouds);
    (function rotateClouds() {
      clouds.rotation.y -= 0.006 * Math.PI / 180;
      requestAnimationFrame(rotateClouds);
    })();
  });

  /* ₿ viajando por arcos */
  function btcSprite() {
    const c = document.createElement('canvas'); c.width = c.height = 64;
    const g = c.getContext('2d');
    g.shadowColor = '#F7931A'; g.shadowBlur = 20; g.fillStyle = '#F7931A';
    g.font = '700 46px Inter,sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillText('₿', 32, 35);
    g.shadowBlur = 0; g.strokeStyle = '#F7931A'; g.lineWidth = 1.5; g.strokeText('₿', 32, 35);
    const s = new THREE.Sprite(new THREE.SpriteMaterial({
      map: new THREE.CanvasTexture(c), transparent: true, depthWrite: false,
      blending: THREE.AdditiveBlending
    }));
    s.scale.set(8, 8, 1); return s;
  }

  const flyers = [];
  const TOTAL_FLY = 12, PAC_FLY = 3;
  for (let i = 0; i < TOTAL_FLY; i++) {
    const sp = btcSprite(); world.scene().add(sp);
    const arcIdx = i < PAC_FLY
      ? pacArcIdx[(Math.random() * pacArcIdx.length) | 0]
      : (Math.random() * arcs.length) | 0;
    flyers.push({ sp, arc: arcs[arcIdx], pacBias: i < PAC_FLY, t: Math.random(), speed: 0.0016 + Math.random() * 0.0014 });
  }

  function pickArc(pb) {
    return pb ? arcs[pacArcIdx[(Math.random() * pacArcIdx.length) | 0]] : arcs[(Math.random() * arcs.length) | 0];
  }
  function lerpAng(a, b, t) {
    let d = b - a;
    if (d > 180) d -= 360;
    if (d < -180) d += 360;
    return a + d * t;
  }

  (function flyLoop() {
    for (const f of flyers) {
      if (!reduce) f.t += f.speed;
      if (f.t > 1) { f.t = 0; f.arc = pickArc(f.pacBias); }
      const A = f.arc;
      const lat = A.startLat + (A.endLat - A.startLat) * f.t;
      const lng = lerpAng(A.startLng, A.endLng, f.t);
      const alt = 0.02 + Math.sin(f.t * Math.PI) * 0.24;
      const p = world.getCoords(lat, lng, alt);
      f.sp.position.set(p.x, p.y, p.z);
    }
    requestAnimationFrame(flyLoop);
  })();
</script>

<!-- Hamburger móvil -->
<script is:inline>
(function () {
  const hamburger = document.getElementById('hamburger');
  const navMenu   = document.getElementById('nav-menu');

  hamburger.addEventListener('click', function (e) {
    e.stopPropagation();
    const open = navMenu.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.querySelector('.t').textContent = open ? '✕' : '☰';
  });

  document.addEventListener('click', function (e) {
    if (!navMenu.contains(e.target) && e.target !== hamburger && !hamburger.contains(e.target)) {
      navMenu.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.querySelector('.t').textContent = '☰';
    }
  });

  navMenu.querySelectorAll('a').forEach(function (link) {
    link.addEventListener('click', function () {
      navMenu.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.querySelector('.t').textContent = '☰';
    });
  });
})();
</script>
