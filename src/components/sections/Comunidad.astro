  border: 1px solid rgba(247,147,26,0.25);
  border-radius: 20px;
  box-shadow: 0 0 40px rgba(247,147,26,0.18), 0 0 100px rgba(247,147,26,0.08), var(--shadow-deep);
  overflow: hidden;
  background: var(--bg-glass);
  /* El zoom del MARCO COMPLETO (imagen + borde) vive en su propio transform.
     Como la flotación está en .comunidad-floater, scale y translateY se
     componen (floater translateY * frame scale) sin pisarse. */
  transform: scale(1);
