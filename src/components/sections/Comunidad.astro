.comunidad-glow {
  position: absolute;
  width: 115%;
  height: 115%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(247,147,26,0.12), transparent 68%);
  filter: blur(40px);
  pointer-events: none;
  z-index: 0;
  animation: comunidadGlowBreath 6s ease-in-out infinite alternate;
  transition: opacity 0.4s ease, filter 0.4s ease, background 0.4s ease;
}
@keyframes comunidadGlowBreath {
  from { opacity: 0.7; }
  to   { opacity: 1; }
}
/* Wrapper de flotación: SOLO translateY ±8px en loop de 7s. Aislar la
   flotación acá deja libre el transform del marco para el zoom. */
.comunidad-floater {
  width: 100%;
  animation: comunidadFloat 7s ease-in-out infinite;
}
@keyframes comunidadFloat {
  0%, 100% { transform: translateY(-8px); }
  50%      { transform: translateY(8px); }
