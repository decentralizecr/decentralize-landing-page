---
// Sección 7 — Comunidad Discord · galaxia espiral logarítmica (Canvas 2D) en el
// fondo, columna texto (45%) + columna imagen (55%) con Servidor.png en marco
// glass y 5 avatares orbitando el núcleo galáctico.
//
// NOTA DE COPY: el blueprint/PROGRESS no traen copy canónico de esta sección.
// Todo el texto visible de abajo es PLACEHOLDER (marcado en el reporte como
// DECISIÓN NECESARIA). El asset Servidor.png SÍ existe en /public.

const beneficios = [
  { icon: 'percent',    text: 'Tarifas preferenciales para comprar BTC' },
  { icon: 'headphones', text: 'Soporte 24/7, nunca estás solo' },
  { icon: 'users',      text: 'Networking con bitcoiners de tus valores' },
  { icon: 'calendar',   text: 'Eventos y llamadas 1:1 con Alberto' },
  { icon: 'tag',        text: 'Descuentos en negocios del ecosistema' },
  { icon: 'line-chart', text: 'Análisis que no compartimos en redes' },
];

// Canales REALES del Discord. `voz: true` = canales de voz (sin "#").
// El orden del array (1..5) define la colocación por nth-child en el grid:
// Caja 1 -> col 1, Caja 2/3/4 -> col 2 apiladas, Caja 5 -> col 3 (desktop).
const cajas = [
  {
    titulo: 'Comunidad Decentralize',
    voz: false,
    canales: [
      { emoji: '📣', nombre: 'anuncios' },
      { emoji: '💎', nombre: 'beneficios-exclusivos' },
      { emoji: '📅', nombre: 'próximos-eventos' },
      { emoji: '💰', nombre: 'programa-de-referidos' },
      { emoji: '💯', nombre: 'testimonios' },
      { emoji: '💬', nombre: 'chat-general' },
    ],
  },
  {
    titulo: 'Bitcoin Masterclass',
    voz: false,
    canales: [
      { emoji: '🎓', nombre: 'bitcoin-masterclass' },
      { emoji: '❓', nombre: 'dudas-del-bitcoin-masterclass' },
    ],
  },
  {
    titulo: 'Compra y Venta Bitcoin',
    voz: false,
    canales: [
      { emoji: '📌', nombre: 'tarifas-de-compra-y-venta' },
      { emoji: '🔄', nombre: 'crea-orden-de-compra-o-venta' },
    ],
  },
  {
    titulo: 'Llamadas Decentralize',
    voz: true,
    canales: [
      { emoji: '🔊', nombre: 'Llamada General' },
      { emoji: '🎙️', nombre: 'Llamadas 1-1' },
    ],
  },
  {
    titulo: 'Bitcoin Only ₿',
    voz: false,
    canales: [
      { emoji: '💬', nombre: 'bitcoin-chat' },
      { emoji: '🧑‍💻', nombre: 'ayuda-técnica-bitcoin' },
      { emoji: '📈', nombre: 'noticias-del-mercado' },
      { emoji: '📚', nombre: 'recursos-útiles' },
      { emoji: '🎨', nombre: 'bitcoin-art' },
      { emoji: '😂', nombre: 'bitcoin-memes' },
    ],
  },
];

// 5 avatares de la comunidad orbitando el núcleo. period 15-22s, dir alternada.
const avatares = [
  { ini: 'AC', bg: '#F7931A', period: 16, dir: 1,  phase: 0 },
  { ini: 'MR', bg: '#3A4252', period: 19, dir: -1, phase: 72 },
  { ini: 'JS', bg: '#CC7A00', period: 22, dir: 1,  phase: 144 },
  { ini: 'KV', bg: '#2E3642', period: 15, dir: -1, phase: 216 },
  { ini: 'DT', bg: '#FFB347', period: 18, dir: 1,  phase: 288 },
];
---

<section id="comunidad" class="comunidad sec">
  <!-- Fondo: galaxia espiral logarítmica (Canvas 2D, z-0). Backdrop semi-
       translúcido para que se vea el #space base detrás. -->
  <div class="comunidad-bg" aria-hidden="true">
    <canvas class="comunidad-galaxy"></canvas>
  </div>

  <div class="wrap">
    <!-- Pill "COMUNIDAD": encabezado centrado sobre TODA la sección, fuera del
         grid de 2 columnas. Se centra respecto a la sección completa con
         margin-inline:auto; NO depende del ancho de la columna ni del reflow del
         acordeón (antes, dentro de la columna con left:% sobre relative, se movía
         al abrir "Ver canales"). El H2/subtítulo/beneficios siguen a la izquierda. -->
    <p class="eyebrow comunidad-eyebrow comunidad-reveal" style="--del:0s">COMUNIDAD</p>

    <div class="comunidad-grid">
      <!-- ── Columna texto (45%) ── -->
      <div class="comunidad-text">
        <h2 class="comunidad-h2 comunidad-reveal" style="--del:0.08s">
          Acceso a la <span class="accent">comunidad</span> Decentralize
        </h2>

        <p class="comunidad-sub comunidad-reveal" style="--del:0.14s">
          No se trata solo de aprender Bitcoin. Se trata de rodearte de las personas correctas.
        </p>

        <ul class="comunidad-benefits">
          {beneficios.map((b, i) => (
            <li class="comunidad-benefit comunidad-reveal" style={`--del:${0.22 + i * 0.1}s`}>
              <span class="comunidad-benefit-icon">
                {b.icon === 'percent' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="5" x2="5" y2="19"/>
                    <circle cx="6.5" cy="6.5" r="2.5"/>
                    <circle cx="17.5" cy="17.5" r="2.5"/>
                  </svg>
                )}
                {b.icon === 'headphones' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>
                  </svg>
                )}
                {b.icon === 'users' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                )}
                {b.icon === 'calendar' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                )}
                {b.icon === 'tag' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                    <line x1="7" y1="7" x2="7.01" y2="7"/>
                  </svg>
                )}
                {b.icon === 'line-chart' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18"/>
                    <path d="m19 9-5 5-4-4-3 3"/>
                  </svg>
                )}
              </span>
              <span class="comunidad-benefit-text">{b.text}</span>
            </li>
          ))}
        </ul>

        <!-- CTA: cierra la columna de texto, centrado bajo los beneficios.
             En mobile queda entre el texto y la imagen. Glow naranja pulsante. -->
        <a href="#precio" class="comunidad-btn comunidad-btn-primary comunidad-reveal comunidad-cta" style="--del:0.5s">
          Quiero unirme
        </a>
      </div>

      <!-- ── Columna imagen (55%): imagen + "Ver canales" + acordeón ── -->
      <div class="comunidad-imgcol">
        <!-- .comunidad-visual envuelve SOLO imagen + órbita: la galaxia y los
             avatares siguen centrados en la imagen (su rect no cambia). -->
        <div class="comunidad-visual comunidad-reveal" style="--del:0.3s">
          <!-- Glow ambiental detrás del marco: respira en loop e intensifica al
               hover. Mismo efecto que la foto de "Mi Historia". -->
          <div class="comunidad-glow" aria-hidden="true"></div>
          <!-- .comunidad-floater hace la flotación (translateY); .comunidad-frame
               hace el zoom (scale) al interactuar. Transforms en elementos
               distintos: se componen, no se anulan. -->
          <div class="comunidad-floater">
            <div class="comunidad-frame">
              <img
                class="comunidad-server-img"
                src="/Servidor.png"
                width="720"
                height="540"
                loading="lazy"
                decoding="async"
                alt="Servidor de Discord de la comunidad Decentralize"
              />
            </div>
          </div>

          <!-- Avatares orbitando el núcleo galáctico (DIVs animados por JS) -->
          <div class="comunidad-orbit" aria-hidden="true">
            {avatares.map((a, i) => (
              <div
                class="orbit-avatar"
                data-i={i}
                data-period={a.period}
                data-dir={a.dir}
                data-phase={a.phase}
                style={`--av-bg:${a.bg}`}
              >
                {a.ini}
                <span class="orbit-dot"></span>
              </div>
            ))}
          </div>
        </div>

        <!-- "Ver canales": centrado bajo la imagen; togglea el acordeón que abre
             debajo, dentro de esta columna derecha. -->
        <button type="button" class="comunidad-btn comunidad-btn-ghost comunidad-reveal comunidad-act-ver" style="--del:0.5s" aria-expanded="false" aria-controls="comunidad-channels">
          <span class="comunidad-btn-label">Ver canales</span>
          <svg class="comunidad-btn-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <!-- Panel de canales: confinado al ANCHO DE LA IMAGEN (vive dentro de
             .comunidad-imgcol, la columna derecha ~55%). Abre debajo del botón.
             El botón se mueve al PIE cuando el panel está abierto vía `order`
             (ver CSS, disparado por aria-expanded). grid-rows 0fr -> 1fr anima. -->
        <div id="comunidad-channels" class="comunidad-channels">
          <div class="comunidad-channels-inner">
            <!-- 3 columnas verticales fijas, compactas. Izq y der = 1 caja
                 (align arriba); centro = flex-column con 3 cajas apiladas.
                 grupos: [Caja1] · [Caja2,3,4] · [Caja5]. -->
            <div class="comunidad-channels-grid">
              <div class="cc-col cc-col-left">
                {cajas.slice(0, 1).map((caja) => (
                  <div class="cc-caja">
                    <p class="cc-caja-title">{caja.titulo}</p>
                    <ul class="cc-list">
                      {caja.canales.map((c) => (
                        <li class="cc-channel">
                          <span class="cc-emoji">{c.emoji}</span>
                          <span class="cc-name">{!caja.voz && <span class="cc-hash">#</span>}{c.nombre}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <div class="cc-col cc-col-center">
                {cajas.slice(1, 4).map((caja) => (
                  <div class="cc-caja">
                    <p class="cc-caja-title">{caja.titulo}</p>
                    <ul class="cc-list">
                      {caja.canales.map((c) => (
                        <li class="cc-channel">
                          <span class="cc-emoji">{c.emoji}</span>
                          <span class="cc-name">{!caja.voz && <span class="cc-hash">#</span>}{c.nombre}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <div class="cc-col cc-col-right">
                {cajas.slice(4, 5).map((caja) => (
                  <div class="cc-caja">
                    <p class="cc-caja-title">{caja.titulo}</p>
                    <ul class="cc-list">
                      {caja.canales.map((c) => (
                        <li class="cc-channel">
                          <span class="cc-emoji">{c.emoji}</span>
                          <span class="cc-name">{!caja.voz && <span class="cc-hash">#</span>}{c.nombre}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.comunidad {
  background: var(--bg-base);
  position: relative;
  z-index: 10;
  overflow: hidden;
  padding-top: 80px;
  padding-bottom: 80px;
}

/* ---- Fondo galaxia espiral ---- */
.comunidad-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  /* Backdrop semi-translúcido: deja ver el #space base (#060607) detrás. */
  background: rgba(7, 7, 8, 0.5);
}
.comunidad-galaxy {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  /* Capa de compositing propia: no repinta el contenido de encima. */
  transform: translateZ(0);
}

.comunidad .wrap {
  position: relative;
  z-index: 1;
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ---- Grid 45 / 55 ---- */
/* Desktop: 2 columnas. Izquierda = texto + beneficios + CTA "Quiero unirme".
   Derecha = imagen + "Ver canales" + acordeón. En mobile colapsa a una sola
   columna y, por el orden del DOM, queda: texto → beneficios → "Quiero unirme"
   → imagen → "Ver canales" → acordeón. */
.comunidad-grid {
  display: grid;
  grid-template-columns: 45% 55%;
  column-gap: 56px;
  align-items: center;
}

/* ---- Columna texto (izquierda) ---- */
.comunidad-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}
/* Pill como encabezado centrado de la sección. Vive fuera del grid, como hijo
   directo de .wrap. display:block + width:max-content + margin-inline:auto lo
   centra respecto a la sección completa (.wrap), de forma estable: no usa left:%
   ni depende del reflow del acordeón, así que NO se mueve al abrir/cerrar los
   canales. Mobile (una sola columna): mismo método, centrado a todo el ancho.
   El H2, subtítulo y beneficios siguen a la izquierda dentro del grid. */
.comunidad-eyebrow {
  display: block;
  width: max-content;
  max-width: 100%;
  margin: 0 auto 16px;
}

.comunidad-h2 {
  font: 700 clamp(2rem, 4.5vw, 3.2rem)/1.15 var(--font-display);
  letter-spacing: -0.02em;
  color: var(--txt-hi);
  margin: 0 0 16px;
}
.accent { color: var(--btc); }

.comunidad-sub {
  font: 400 1.05rem/1.7 var(--font-body);
  color: var(--txt-body);
  max-width: 460px;
  margin: 0 0 28px;
}

/* ---- Beneficios ---- */
.comunidad-benefits {
  list-style: none;
  margin: 0;
  padding: 0;
  /* 6 beneficios en 2 columnas x 3 filas (desktop) para no ocupar mucho alto. */
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  column-gap: 24px;
  row-gap: 16px;
  width: 100%;
}
.comunidad-benefit {
  display: flex;
  align-items: center;
  gap: 16px;
}
.comunidad-benefit-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--btc);
}
.comunidad-benefit-icon svg {
  width: 20px;
  height: 20px;
  /* Glow naranja parpadeante (respiración) en los 4 iconos de beneficios.
     Dos drop-shadow apilados (núcleo brillante + halo ancho) para que el
     resplandor se vea de verdad alrededor del trazo fino del icono. */
  animation: comunidadIconGlow 2.5s ease-in-out infinite;
}
/* Leve desfase entre iconos para un latido escalonado, no sincronizado. */
.comunidad-benefit:nth-child(1) .comunidad-benefit-icon svg { animation-delay: 0s; }
.comunidad-benefit:nth-child(2) .comunidad-benefit-icon svg { animation-delay: 0.35s; }
.comunidad-benefit:nth-child(3) .comunidad-benefit-icon svg { animation-delay: 0.7s; }
.comunidad-benefit:nth-child(4) .comunidad-benefit-icon svg { animation-delay: 1.05s; }
.comunidad-benefit:nth-child(5) .comunidad-benefit-icon svg { animation-delay: 1.4s; }
.comunidad-benefit:nth-child(6) .comunidad-benefit-icon svg { animation-delay: 1.75s; }
@keyframes comunidadIconGlow {
  0%, 100% {
    filter: drop-shadow(0 0 2px rgba(247,147,26,0.45)) drop-shadow(0 0 4px rgba(247,147,26,0.2));
  }
  50% {
    filter: drop-shadow(0 0 7px rgba(247,147,26,1)) drop-shadow(0 0 16px rgba(247,147,26,0.85));
  }
}
.comunidad-benefit-text {
  font: 400 15px/1.5 var(--font-body);
  color: var(--txt-body);
}

/* ---- CTA "Quiero unirme": cierra la columna de texto, centrado ---- */
.comunidad-cta {
  align-self: center;
  margin-top: 32px;
}

/* ---- Columna imagen (derecha): imagen + "Ver canales" + acordeón ---- */
.comunidad-imgcol {
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* "Ver canales" centrado bajo la imagen. Orden por defecto: bajo la imagen. */
.comunidad-act-ver { margin-top: 24px; order: 1; }
/* El panel abre dentro de la columna imagen, confinado a su ancho. */
.comunidad-channels { order: 2; margin-top: 0; }
.comunidad-channels.is-open { margin-top: 18px; }
/* Panel ABIERTO: el botón "Ocultar canales" se va al PIE (debajo de las cajas).
   Disparado por aria-expanded, sin tocar el JS. */
.comunidad-act-ver[aria-expanded="true"] { order: 3; }

/* ---- Botones glass ---- */
.comunidad-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font: 600 15px/1 var(--font-body);
  border-radius: 12px;
  padding: 14px 22px;
  cursor: pointer;
  text-decoration: none;
  transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, transform 0.3s ease;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}
/* Ghost (Ver canales): glass neutro con borde naranja tenue + glow naranja de
   reposo que respira en loop (mismo lenguaje y keyframe que "Quiero unirme", para
   invitar al clic). En hover se detiene el pulso y el glow se intensifica. */
.comunidad-btn-ghost {
  background: var(--bg-glass);
  border: 1px solid rgba(247,147,26,0.28);
  color: var(--txt-hi);
  animation: comunidadCtaPulse 2.6s ease-in-out infinite;
}
.comunidad-btn-chev {
  width: 18px;
  height: 18px;
  /* Glow naranja propio del chevron (respira en sync con el botón). transform
     conserva la rotación al abrir/cerrar; filter se suma encima sin romperla. */
  color: var(--btc);
  transition: transform 0.4s var(--ease-out), filter 0.3s ease;
  animation: comunidadChevGlow 2.6s ease-in-out infinite;
}
@keyframes comunidadChevGlow {
  0%, 100% { filter: drop-shadow(0 0 2px rgba(247,147,26,0.5)) drop-shadow(0 0 5px rgba(247,147,26,0.25)); }
  50%      { filter: drop-shadow(0 0 6px rgba(247,147,26,1)) drop-shadow(0 0 13px rgba(247,147,26,0.6)); }
}
.comunidad-btn-ghost[aria-expanded="true"] .comunidad-btn-chev {
  transform: rotate(180deg);
}
/* Primary (CTA): glass naranja con glow naranja pulsante en reposo (invita al
   clic). El pulso late de baja a alta intensidad en loop. */
.comunidad-btn-primary {
  background: rgba(247,147,26,0.16);
  border: 1px solid rgba(247,147,26,0.5);
  color: var(--txt-hi);
  animation: comunidadCtaPulse 2.6s ease-in-out infinite;
}
@keyframes comunidadCtaPulse {
  0%, 100% { box-shadow: 0 0 6px rgba(247,147,26,0.18); }
  50%      { box-shadow: 0 0 26px rgba(247,147,26,0.55); }
}
@media (hover: hover) and (pointer: fine) {
  /* Hover detiene el pulso y aplica glow naranja más intenso (botón + chevron). */
  .comunidad-btn-ghost:hover {
    animation: none;
    border-color: rgba(247,147,26,0.85);
    box-shadow: 0 0 30px rgba(247,147,26,0.5);
    background: rgba(247,147,26,0.1);
  }
  .comunidad-btn-ghost:hover .comunidad-btn-chev {
    animation: none;
    filter: drop-shadow(0 0 7px rgba(247,147,26,1)) drop-shadow(0 0 16px rgba(247,147,26,0.75));
  }
  /* Hover detiene el pulso y aplica un glow más intenso vía transition. */
  .comunidad-btn-primary:hover {
    animation: none;
    border-color: rgba(247,147,26,0.85);
    box-shadow: 0 0 34px rgba(247,147,26,0.5);
    background: rgba(247,147,26,0.24);
    transform: translateY(-2px);
  }
}

/* ---- Acordeón de canales (grid-rows 0fr → 1fr) ---- */
.comunidad-channels {
  width: 100%;
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.4s var(--ease-out);
}
.comunidad-channels.is-open {
  grid-template-rows: 1fr;
}
.comunidad-channels-inner {
  overflow: hidden;
  min-height: 0;
}

/* ---- Grid de 3 columnas verticales fijas (desktop) ----
   3 columnas (izq / centro / der). Izq = Caja 1; centro = Cajas 2/3/4 apiladas
   en flex-column; der = Caja 5. align-items:start: las columnas no se estiran a
   la altura de la más alta, cada una arranca arriba. */
.comunidad-channels-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: start;
  gap: 12px;
  padding: 12px 0 2px;
}
/* Columna central: apila sus 3 cajas verticalmente con el mismo gap. */
.cc-col-center {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ---- Caja glass translúcida (deja ver el remolino difuminado detrás) ----
   Fondo oscuro de alpha bajo + blur: la galaxia espiral pasa difuminada por
   atrás. Borde naranja con glow INTERMITENTE (respiración ~2.7s), escalonado
