</style>

<script is:inline>
(function () {
  const root = document.querySelector('#comunidad');
  if (!root) return;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Reveal stagger (IO tras parseo del script) ---------- */
  const revEls = root.querySelectorAll('.comunidad-reveal');
  if (reduce) {
    revEls.forEach(el => el.classList.add('visible'));
  } else {
    const revObs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          revObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    revEls.forEach(el => revObs.observe(el));
  }

  /* ---------- Acordeón de canales ---------- */
  const btn = root.querySelector('.comunidad-btn-ghost');
  const panel = root.querySelector('#comunidad-channels');
  const label = root.querySelector('.comunidad-btn-label');
  if (btn && panel && label) {
    btn.addEventListener('click', () => {
      const open = panel.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      label.textContent = open ? 'Ocultar canales' : 'Ver canales';
    });
  }

  /* ---------- Avatares orbitando ---------- */
  const orbit = root.querySelector('.comunidad-orbit');
  const frame = root.querySelector('.comunidad-frame');
  const floater = root.querySelector('.comunidad-floater');
  const avatars = orbit ? Array.from(orbit.querySelectorAll('.orbit-avatar')) : [];
  let orbitRunning = false, orbitRaf = null, orbitT = 0, orbitLast = 0;
  let rx = 160, ry = 120;

  /* --- Física de colisión por avatar ---
     Cada avatar tiene un OFFSET (ox,oy) respecto a su posición orbital, con su
     propia velocidad (vx,vy). Un resorte amortiguado lo tira de vuelta a (0,0)
     (su órbita): a = -STIFF*offset - DAMP*vel. El golpe inyecta velocidad en la
     dirección contacto -> avatar (lo aleja del punto de impacto). La órbita base
     (bx,by) sigue avanzando por debajo; el offset spring se suma encima. */
  const n = avatars.length;
  const ox = new Float64Array(n), oy = new Float64Array(n);
  const vx = new Float64Array(n), vy = new Float64Array(n);
  const bx = new Float64Array(n), by = new Float64Array(n); // base orbital actual
  const inside = new Array(n).fill(false);                  // histéresis de proximidad
  const STIFF = 180;        // rigidez del resorte (omega ~ 13.4 rad/s)
  const DAMP = 9;           // amortiguación (zeta ~ 0.34: vuelve en ~0.9s con un par de rebotes)
  const IMPULSE = 540;      // velocidad inyectada por golpe (px/s) -> pico ~40px
  const MAX_OFF = 60;       // tope de desplazamiento para no salir de la sección
  const HIT_R = 30;         // radio de contacto (cursor entra y golpea)

  // Golpe: empuja el avatar i alejándolo del punto de contacto (cx,cy) en coords
  // locales de la órbita. strength escala el impulso (0..1).
  function hitAvatar(i, cx, cy, strength) {
    let dx = (bx[i] + ox[i]) - cx;
    let dy = (by[i] + oy[i]) - cy;
    let len = Math.hypot(dx, dy);
    if (len < 0.001) { // contacto en el centro: empuje radial hacia afuera
      const rl = Math.hypot(bx[i], by[i]) || 1;
      dx = bx[i] / rl; dy = by[i] / rl;
    } else {
      dx /= len; dy /= len;
    }
    const imp = IMPULSE * (strength == null ? 1 : strength);
    vx[i] += dx * imp;
    vy[i] += dy * imp;
  }

  // Integración del resorte (Euler) + clamp del offset.
  function integrateSprings(dt) {
    for (let i = 0; i < n; i++) {
      vx[i] += (-STIFF * ox[i] - DAMP * vx[i]) * dt;
      vy[i] += (-STIFF * oy[i] - DAMP * vy[i]) * dt;
      ox[i] += vx[i] * dt;
      oy[i] += vy[i] * dt;
      // clamp radial del offset
      const d = Math.hypot(ox[i], oy[i]);
      if (d > MAX_OFF) { const k = MAX_OFF / d; ox[i] *= k; oy[i] *= k; }
    }
  }

  // Centro de la órbita en pantalla = centro de .comunidad-orbit.
  function orbitCenter() {
    const r = orbit.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  }

  function measureOrbit() {
    if (!frame) return;
    const w = frame.offsetWidth, h = frame.offsetHeight;
    rx = w * 0.58;
    ry = h * 0.5;
  }
  function placeAvatars(t) {
    for (let i = 0; i < n; i++) {
      const a = avatars[i];
      const period = parseFloat(a.dataset.period) || 18;
      const dir = parseFloat(a.dataset.dir) || 1;
      const phase = (parseFloat(a.dataset.phase) || 0) * Math.PI / 180;
      const ang = phase + dir * (t * 2 * Math.PI / period);
      const x = Math.cos(ang) * rx;
      const y = Math.sin(ang) * ry;
      bx[i] = x; by[i] = y;
      // Offset por colisión sumado encima de la órbita.
      const px = x + ox[i], py = y + oy[i];
      // Micro-scale opcional en el impacto, proporcional a la velocidad (sutil).
      const speed = Math.hypot(vx[i], vy[i]);
      const scale = 1 + Math.min(0.12, speed / 6000);
      a.style.transform = `translate(${px.toFixed(1)}px, ${py.toFixed(1)}px) scale(${scale.toFixed(3)})`;
      // Profundidad: detrás del marco cuando sin(ang) < 0
      a.style.zIndex = Math.sin(ang) < 0 ? '1' : '3';
    }
  }
  function orbitTick(now) {
    const dt = orbitLast ? Math.min((now - orbitLast) / 1000, 0.05) : 0.016;
    orbitLast = now;
    orbitT += dt;
    integrateSprings(dt);
    placeAvatars(orbitT);
    orbitRaf = requestAnimationFrame(orbitTick);
  }

  /* ---------- Galaxia espiral logarítmica (Canvas 2D) ---------- */
  const canvas = root.querySelector('.comunidad-galaxy');
  const bg = root.querySelector('.comunidad-bg');
  const visual = root.querySelector('.comunidad-visual');
  let galaxyState = null;

  function buildGalaxy() {
    const ctx = canvas.getContext('2d');
    const DPR = Math.min(window.devicePixelRatio || 1, 1.5);
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const COUNT = isMobile ? 100 : 200;
    let W = 0, H = 0, cx = 0, cy = 0, scale = 1;
    let stars = [];

    // Sprites pre-renderizados (blanco + naranja) para drawImage barato.
    function makeSprite(rgb) {
      const S = 16;
      const c = document.createElement('canvas');
      c.width = c.height = S;
      const sc = c.getContext('2d');
      const g = sc.createRadialGradient(S/2, S/2, 0, S/2, S/2, S/2);
      g.addColorStop(0, `rgba(${rgb},1)`);
      g.addColorStop(0.4, `rgba(${rgb},0.6)`);
      g.addColorStop(1, `rgba(${rgb},0)`);
      sc.fillStyle = g;
      sc.fillRect(0, 0, S, S);
      return c;
    }
    const spriteWhite = makeSprite('255,255,255');
    const spriteOrange = makeSprite('247,147,26');

    // Espiral logarítmica r = a·e^(b·θ), 2 brazos, dispersión aleatoria.
    function buildStars() {
      stars = [];
      const a = 6, b = 0.30, arms = 2, turns = 3.2;
      for (let i = 0; i < COUNT; i++) {
        const arm = i % arms;
        const tt = Math.pow(Math.random(), 0.7);      // más densas hacia el centro
        const theta = tt * turns * Math.PI * 2;
        let r = a * Math.exp(b * theta);
        const armAngle = (arm / arms) * Math.PI * 2;
        // dispersión que crece con el radio (brazos difusos, no líneas)
        const spread = (Math.random() - 0.5) * (0.18 + r * 0.0016);
        const ang = theta + armAngle + spread;
        const jitter = (Math.random() - 0.5) * r * 0.12;
        const depth = Math.min(r / 280, 1);           // 0 centro → 1 borde
        stars.push({
          r: r + jitter,
          ang,
          orange: Math.random() < 0.20,
          size: (1.1 + Math.random() * 1.8) * (1 - depth * 0.35),
          alpha: 0.65 - depth * 0.4 + Math.random() * 0.12,
          flash: 0,
        });
      }
    }

    function resize() {
      W = bg.offsetWidth; H = bg.offsetHeight;
      canvas.width = Math.floor(W * DPR);
      canvas.height = Math.floor(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      // Centro de la espiral = centro de la columna imagen (núcleo galáctico).
      if (visual) {
        const vb = visual.getBoundingClientRect();
        const bb = bg.getBoundingClientRect();
        cx = vb.left - bb.left + vb.width / 2;
        cy = vb.top - bb.top + vb.height / 2;
      } else {
        cx = W * 0.72; cy = H * 0.5;
      }
      scale = Math.max(W, H) / 520;
      buildStars();
    }

    function drawDustLanes(rot) {
      // Arcos oscuros entre los brazos brillantes (dust lanes).
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(rot * 0.6);
      ctx.globalCompositeOperation = 'source-over';
      const a = 6, b = 0.30;
      for (let lane = 0; lane < 2; lane++) {
        const off = Math.PI + lane * Math.PI; // entre los 2 brazos
        ctx.beginPath();
        for (let th = 0.4; th < 3.2 * Math.PI * 2; th += 0.12) {
          const r = a * Math.exp(b * th) * scale;
          const x = Math.cos(th + off) * r;
          const y = Math.sin(th + off) * r;
          if (th === 0.4) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = 'rgba(2,2,4,0.55)';
        ctx.lineWidth = 14 * scale;
        ctx.lineCap = 'round';
        ctx.stroke();
      }
      ctx.restore();
    }

    let coreGrad = null;
    function drawCore() {
      const cr = 150 * scale;
      if (!coreGrad) {
        coreGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, cr);
        coreGrad.addColorStop(0,   'rgba(255,220,160,0.55)');
        coreGrad.addColorStop(0.18,'rgba(247,180,90,0.32)');
        coreGrad.addColorStop(0.5, 'rgba(247,147,26,0.10)');
        coreGrad.addColorStop(1,   'rgba(247,147,26,0)');
      }
      ctx.save();
      ctx.translate(cx, cy);
      ctx.globalCompositeOperation = 'lighter';
      ctx.fillStyle = coreGrad;
      ctx.beginPath();
      ctx.arc(0, 0, cr, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    let rot = 0, flashTimer = 0;
    function render(dt) {
      rot += dt * 0.045; // rotación lenta, contemplativa
      ctx.clearRect(0, 0, W, H);

      drawDustLanes(rot);
      drawCore();

      // Destello: cada ~3s una estrella aleatoria destella y decae en ~1s.
      flashTimer -= dt;
      if (flashTimer <= 0) {
        flashTimer = 3;
        const s = stars[(Math.random() * stars.length) | 0];
        if (s) s.flash = 1;
      }

      ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        const ang = s.ang + rot;
        const r = s.r * scale;
        const x = cx + Math.cos(ang) * r;
        const y = cy + Math.sin(ang) * r;
        let size = s.size * scale * 1.6;
        let alpha = s.alpha;
        if (s.flash > 0) {
          s.flash = Math.max(0, s.flash - dt); // decae en ~1s
          size *= 1 + 1.5 * s.flash;
          alpha = Math.min(1, alpha + 0.5 * s.flash);
        }
        const d = size * 2;
        ctx.globalAlpha = alpha;
        ctx.drawImage(s.orange ? spriteOrange : spriteWhite, x - size, y - size, d, d);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    function renderStatic() { render(0); }

    return { ctx, resize, render, renderStatic };
  }

  /* ---------- Arranque + IntersectionObserver (pausa fuera de viewport) ---------- */
  function init() {
    measureOrbit();

    if (reduce) {
      // Estático: galaxia dibujada una vez, avatares colocados una vez.
      if (canvas && bg) {
        const g = buildGalaxy();
        g.resize();
        g.renderStatic();
        let lastW = window.innerWidth, resizeT;
        window.addEventListener('resize', () => {
          if (window.innerWidth === lastW) return;   // C-08: ignorar el resize de solo-alto (barra iOS)
          lastW = window.innerWidth;
          clearTimeout(resizeT); resizeT = setTimeout(() => { g.resize(); g.renderStatic(); }, 200);
        }, { passive: true });
      }
      placeAvatars(0);
      return;
    }

    // Desktop: el cursor "golpea" al entrar en el radio del avatar (pointermove
    // con puntero fino). Histéresis con `inside` para un golpe por entrada.
    visual.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const c = orbitCenter();
      const cx = e.clientX - c.x, cy = e.clientY - c.y;
      for (let i = 0; i < n; i++) {
        const ax = bx[i] + ox[i], ay = by[i] + oy[i];
        const d = Math.hypot(cx - ax, cy - ay);
        if (d < HIT_R) {
          if (!inside[i]) { hitAvatar(i, cx, cy, 1 - d / HIT_R + 0.4); inside[i] = true; }
        } else if (d > HIT_R * 1.25) {
          inside[i] = false;
        }
      }
    }, { passive: true });

    // Mobile: tap sobre un avatar lo golpea desde el punto del dedo.
    avatars.forEach((el, i) => {
      el.addEventListener('pointerdown', (e) => {
        const c = orbitCenter();
        hitAvatar(i, e.clientX - c.x, e.clientY - c.y, 1);
      });
    });

    // Mobile: tap/hold sobre la imagen acerca el marco completo (clase is-pressed,
    // equivalente táctil del hover). Auto-libera por si falta el pointerup.
    let pressTO = null;
    const press = () => {
      visual.classList.add('is-pressed');
      clearTimeout(pressTO);
      pressTO = setTimeout(() => visual.classList.remove('is-pressed'), 1100);
    };
    const unpress = () => { clearTimeout(pressTO); visual.classList.remove('is-pressed'); };
    if (floater) {
      floater.addEventListener('pointerdown', (e) => { if (e.pointerType === 'touch') press(); });
      floater.addEventListener('pointerup', (e) => { if (e.pointerType === 'touch') unpress(); });
      floater.addEventListener('pointercancel', unpress);
    }

    // Galaxia con loop propio, encendido/apagado por el IO.
    // Movil (fix anti-OOM definitivo): NO iniciar el canvas de la galaxia (ni contexto ni rAF).
    // El fondo .comunidad-bg es translucido (rgba 7,7,8,0.5) y deja ver el #space base: la seccion
    // sigue viendose espacial, sin canvas propio. La orbita de avatares (DOM, barata) se mantiene.
    const noCanvasMobile = window.matchMedia('(max-width: 768px)').matches
      || window.matchMedia('(pointer: coarse)').matches;
    if (canvas && bg && !noCanvasMobile) {
      const g = buildGalaxy();
      g.resize();
      galaxyState = { galRunning: false, raf: null, last: 0 };
      const galTick = (now) => {
        if (!galaxyState.galRunning) return;
        const dt = galaxyState.last ? Math.min((now - galaxyState.last) / 1000, 0.05) : 0.016;
        galaxyState.last = now;
        g.render(dt);
        galaxyState.raf = requestAnimationFrame(galTick);
      };
      galaxyState.start = () => { galaxyState.last = 0; galTick(performance.now()); };
      let orbitLastW = window.innerWidth, orbitResizeT;
      window.addEventListener('resize', () => {
        if (window.innerWidth === orbitLastW) return;   // C-08: ignorar el resize de solo-alto (barra iOS)
        orbitLastW = window.innerWidth;
        clearTimeout(orbitResizeT); orbitResizeT = setTimeout(() => { g.resize(); measureOrbit(); }, 200);
      }, { passive: true });
    }

    const target = bg || root;
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          if (galaxyState && !galaxyState.galRunning) { galaxyState.galRunning = true; galaxyState.start(); }
          if (!orbitRunning && avatars.length) { orbitRunning = true; orbitLast = 0; orbitRaf = requestAnimationFrame(orbitTick); }
        } else {
          if (galaxyState && galaxyState.galRunning) { galaxyState.galRunning = false; if (galaxyState.raf) cancelAnimationFrame(galaxyState.raf); }
          if (orbitRunning) { orbitRunning = false; cancelAnimationFrame(orbitRaf); }
        }
      });
    // Móvil: rootMargin 0px para pausar la galaxia apenas sale del viewport real
    // (no precargar vecinos). Baja el pico de memoria en la zona previa a Precio.
    }, { rootMargin: (window.matchMedia('(max-width: 768px)').matches || window.matchMedia('(pointer: coarse)').matches) ? '0px' : '200px' });
    obs.observe(target);
  }

  init();
})();
</script>
