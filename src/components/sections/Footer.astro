// Sección 13 — Redes + Footer · "edge of the universe" (último elemento de la página)
// Cierre del viaje: el campo de estrellas se ADELGAZA hacia abajo y se funde a negro (el viaje
// termina en la frontera del vacío). Patrón autocontenido como el resto del repo: IIFE +
// <script is:inline> + IntersectionObserver + guard de prefers-reduced-motion.
//
// Fondo edge-of-universe (costo bajo):
//   1. Starfield estático SVG (fallback no-JS / reduced-motion), estrellas densas arriba.
//   2. Canvas 2D con el mismo campo + titileo sutil (solo si motion ok); oculta el SVG al activarse.
//   3. 2 galaxias tenues (divs CSS con radial-gradient elíptico, estáticas, sin costo por frame).
//   4. Overlay CSS .ftr-fade: tapa la costura con §12 arriba y funde a negro el borde inferior.
// Transición §12→§13: CtaFinal ya funde su borde inferior a --bg-deep (.cf-basefade); el footer
// arranca en --bg-deep opaco (z-index:10, tapa el Globo fijo z1) => unión negro→negro invisible.
//
// Iconos: simple-icons inline (Instagram, TikTok, Facebook, X con el logo actual), 20px,
// fill currentColor, en nodos glass de 48px que brillan en hover. Pixel diferido: TODO en el
// click de Instagram, sin disparar. Copy voseo, sin guion largo. Disclaimer SUGEF verbatim.

// --- Starfield estático (SVG): generado determinista para SSG estable. Densidad sesgada arriba. ---
function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(137);
const VW = 1000, VH = 600;
const staticStars = Array.from({ length: 72 }, () => {
  const yf = 0.06 + Math.pow(rnd(), 1.7) * 0.84;   // 6%..90%, denso cerca del 6-30%
  const depthFade = 1 - yf;                         // más tenue hacia abajo
  const r = 0.5 + rnd() * 1.1;
  const op = (0.25 + rnd() * 0.5) * (0.25 + 0.75 * depthFade);
  const orange = rnd() < 0.15;
  return {
    x: +(rnd() * VW).toFixed(1),
    y: +(yf * VH).toFixed(1),
    r: +r.toFixed(2),
    op: +op.toFixed(2),
    c: orange ? '#F7931A' : '#ffffff',
  };
});

// --- Redes (simple-icons paths oficiales; X = logo actual, no el pájaro) ---
const socials = [
