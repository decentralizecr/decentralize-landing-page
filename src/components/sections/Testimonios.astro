        X / backdrop / Escape → cierra. */
  const lb = document.querySelector('.testi-lightbox');
  const lbImg = lb && lb.querySelector('.testi-lb-img');
  const lbPill = lb && lb.querySelector('.testi-lb-pill');
  const lbClose = lb && lb.querySelector('.testi-lb-close');
  const lbPrev = lb && lb.querySelector('.testi-lb-prev');
  const lbNext = lb && lb.querySelector('.testi-lb-next');
  if (lb && lbImg && lbPill && lbClose && lbPrev && lbNext) {
    // Datos de los 6 testimonios (NO los 12 duplicados). Deben coincidir con el
    // array `testimonios` del frontmatter (src + pill).
    const testimoniosData = [
      { src: '/testi-1.webp', pill: 'Cliente desde 2022' },
      { src: '/testi-2.webp', pill: 'Cliente desde 2022' },
      { src: '/testi-3.webp', pill: 'Cliente desde 2022' },
      { src: '/testi-4.webp', pill: 'Cliente desde 2023' },
      { src: '/testi-5.webp', pill: 'Cliente desde 2023' },
      { src: '/testi-6.webp', pill: 'Cliente desde 2024' },
    ];
    let currentIdx = 0;

    const openLb = (idx) => {
      currentIdx = ((idx % testimoniosData.length) + testimoniosData.length) % testimoniosData.length;
      const data = testimoniosData[currentIdx];
      lbImg.src = data.src;
      lbPill.textContent = data.pill;
      lb.classList.add('open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // TODO Pixel: track('TestimonioAbierto', { indice: currentIdx }).
    };
    const closeLb = () => {
      lb.classList.remove('open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      window.setTimeout(() => { lbImg.src = ''; lbPill.textContent = ''; }, 250);
    };
    const nav = (delta) => {
      currentIdx = (currentIdx + delta + testimoniosData.length) % testimoniosData.length;
      const data = testimoniosData[currentIdx];
      // Micro-fade de transición entre testimonios.
      lbImg.style.opacity = '0';
      lbPill.style.opacity = '0';
      window.setTimeout(() => {
        lbImg.src = data.src;
        lbPill.textContent = data.pill;
        lbImg.style.opacity = '';
        lbPill.style.opacity = '';
      }, 180);
    };

    root.querySelectorAll('.testi-card').forEach(card => {
      card.addEventListener('click', () => {
        openLb(Number(card.dataset.idx) % testimoniosData.length);
      });
    });
    lbClose.addEventListener('click', closeLb);
    lbPrev.addEventListener('click', () => nav(-1));
    lbNext.addEventListener('click', () => nav(1));
    lb.addEventListener('click', e => { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', e => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') closeLb();
      else if (e.key === 'ArrowLeft') nav(-1);
      else if (e.key === 'ArrowRight') nav(1);
    });
  }

  /* 4) Meteoros (desktop y mobile, no reduced-motion). Sin registro central
        de canvas: factory inline + IO que enciende/apaga el rAF. */
  if (reduce) return;
  // Móvil: canvas de meteoros OFF por completo (mitigación OOM, aprobado por el cliente).
  // Ni contexto ni rAF. El marquee de tarjetas sigue igual. En desktop no cambia nada.
  if (isMobile) return;
  const canvas = document.getElementById('testi-meteors');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const DPR = Math.min(window.devicePixelRatio || 1, isMobile ? 1.0 : 1.5);
  let rafId = null, timeoutId = null, running = false, meteor = null;
  let W = 0, H = 0;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    W = rect.width;
    H = rect.height;
    canvas.width = Math.floor(W * DPR);
    canvas.height = Math.floor(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  // Cada spawn elige un cuadrante de dirección distinto: los meteoros entran
  // desde varios bordes, no siempre top-right → bottom-left.
  const directions = [
    { angleRange: [200, 230] }, // topRight  → bottomLeft
    { angleRange: [310, 340] }, // topLeft   → bottomRight
    { angleRange: [255, 285] }, // top       → bottom (casi vertical)
    { angleRange: [225, 315] }, // topCenter → esquina
  ];

  function spawn() {
    const dir = directions[Math.floor(Math.random() * directions.length)];
    const angleDeg = dir.angleRange[0] + Math.random() * (dir.angleRange[1] - dir.angleRange[0]);
    const angle = angleDeg * Math.PI / 180;
    const speed = 4 + Math.random() * 3;
    const vx = Math.cos(angle) * speed;
    const vy = Math.abs(Math.sin(angle) * speed); // siempre cae

    // Nace fuera del canvas, en el borde opuesto al destino.
    let x, y;
    if (vx > 0.5) {            // va a la derecha: nace a la izquierda
      x = -50;
      y = Math.random() * H * 0.6;
    } else if (vx < -0.5) {    // va a la izquierda: nace a la derecha
      x = W + 50;
      y = Math.random() * H * 0.6;
    } else {                   // casi vertical: nace arriba
      y = -50;
      x = W * 0.2 + Math.random() * W * 0.6;
    }

    const isOrange = Math.random() < 0.7; // ~70% naranja, ~30% blanco
    meteor = {
      x, y, vx, vy,
      life: 0,
      maxLife: 180,
      head:       isOrange ? '#FFB347' : '#FFFFFF',
      trailStart: isOrange ? 'rgba(255,179,71,0.9)' : 'rgba(255,255,255,0.85)',
      trailMid:   isOrange ? 'rgba(247,147,26,0.5)' : 'rgba(200,210,220,0.4)',
      trailEnd:   isOrange ? 'rgba(247,147,26,0)'   : 'rgba(200,210,220,0)',
      shadow:     isOrange ? '#F7931A' : '#FFFFFF',
    };
  }

  function frame() {
    if (!running) return;
    // Estela por alpha-fade (no clearRect): el fill oscuro bajo mix-blend screen
    // ≈ transparente, así los pixeles viejos del meteoro se desvanecen.
    ctx.fillStyle = 'rgba(4,4,5,0.18)';
    ctx.fillRect(0, 0, W, H);

    if (meteor) {
      meteor.x += meteor.vx;
      meteor.y += meteor.vy;
      meteor.life++;

      const trailLen = 60;
      const tx = meteor.x - meteor.vx * trailLen * 0.5;
      const ty = meteor.y - meteor.vy * trailLen * 0.5;
      const grad = ctx.createLinearGradient(meteor.x, meteor.y, tx, ty);
      grad.addColorStop(0, meteor.trailStart);
      grad.addColorStop(0.4, meteor.trailMid);
      grad.addColorStop(1, meteor.trailEnd);
      ctx.strokeStyle = grad;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(meteor.x, meteor.y);
      ctx.lineTo(tx, ty);
      ctx.stroke();

      ctx.globalCompositeOperation = 'lighter';
      ctx.fillStyle = meteor.head;
      ctx.shadowColor = meteor.shadow;
      ctx.shadowBlur = 14;
      ctx.beginPath();
      ctx.arc(meteor.x, meteor.y, 3, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.globalCompositeOperation = 'source-over';

      if (meteor.x < -50 || meteor.x > W + 50 || meteor.y > H + 50 || meteor.life > meteor.maxLife) {
        meteor = null;
        timeoutId = window.setTimeout(spawn, 4000 + Math.random() * 3000); // 4-7s
      }
    }

    rafId = requestAnimationFrame(frame);
  }

  function start() {
    if (running) return;
    running = true;
    resize();
    if (!meteor) spawn();
    rafId = requestAnimationFrame(frame);
  }

  function stop() {
    running = false;
    if (rafId) cancelAnimationFrame(rafId);
    if (timeoutId) clearTimeout(timeoutId);
    rafId = null;
    timeoutId = null;
    meteor = null;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  let meteorLastW = window.innerWidth, meteorResizeT;
  window.addEventListener('resize', () => {
    if (window.innerWidth === meteorLastW) return;   // C-08: ignorar el resize de solo-alto (barra iOS)
    meteorLastW = window.innerWidth;
    clearTimeout(meteorResizeT); meteorResizeT = setTimeout(() => { if (running) resize(); }, 200);
  }, { passive: true });

  let inView = false;
  const meteorObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      inView = e.isIntersecting;
      if (inView && !document.hidden) start();
      else stop();
    });
  }, { rootMargin: isMobile ? '0px' : '200px' });
  meteorObs.observe(root);

  // Pausar (y liberar el canvas) cuando la pestaña pasa a segundo plano, y reanudar
  // al volver si la sección sigue en viewport. Patrón del repo (IO + visibilitychange).
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
    else if (inView) start();
  });
})();
</script>
