<script is:inline>
(function () {
  const root = document.querySelector('#testimonios');
  if (!root) return;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.matchMedia('(max-width: 768px)').matches
    || window.matchMedia('(pointer: coarse)').matches;

  /* 1) Reveal stagger + clase .visible en la sección (dispara fade de nebula/stars). */
  const revEls = root.querySelectorAll('.testi-reveal');
  if (reduce) {
    revEls.forEach(el => el.classList.add('visible'));
    root.classList.add('visible');
  } else {
    const revObs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          revObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    revEls.forEach(el => revObs.observe(el));

    const bgObs = new IntersectionObserver((entries, o) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          root.classList.add('visible');
          // TODO Pixel: track('TestimonioVisto') una sola vez al entrar la sección.
          o.unobserve(e.target);
        }
      });
    }, { threshold: 0.3 });
    bgObs.observe(root);
  }

  /* 2) Marquee drag/swipe + auto-scroll JS-driven (transform por rAF).
        Reemplaza al @keyframes scroll: arrastrar pausa y mueve; soltar resume
        desde la posición actual. Hover (desktop) pausa. Drag real (>5px) suprime
        el click siguiente para que no abra el lightbox. */
  const marquee = root.querySelector('.marquee');
  const track = marquee && marquee.querySelector('.track');
  if (marquee && track) {
    if (!reduce) {
      let trackWidth = 0;   // ancho de UN loop (mitad del track duplicado)
      let translateX = 0;
      let speed = 0;        // px/ms; calculada tras layout (≈ ancho / 32000)
      let isDragging = false;
      let isHovering = false;
      let pointerStartX = 0;
      let pointerStartY = 0;
      let dragStartTranslate = 0;
      let didDrag = false;
      let rafId = null;
      let lastTime = 0;

      function measure() {
        trackWidth = track.scrollWidth / 2;
        speed = trackWidth / 32000; // conserva la cadencia de los 32s/loop
      }

      function tick(now) {
        if (!lastTime) lastTime = now;
        const dt = now - lastTime;
        lastTime = now;

        if (!isDragging && !isHovering) {
          translateX -= speed * dt;
          if (translateX <= -trackWidth) translateX += trackWidth;
        }
        track.style.transform = `translateX(${translateX}px)`;
        rafId = requestAnimationFrame(tick);
      }

      function startDrag(e) {
        if (isDragging) return; // evita doble fire (pointerdown + touchstart)
        isDragging = true;
        didDrag = false;
        // OJO: NO agregar 'dragging' acá. Esa clase pone pointer-events:none en las
        // cards; si se aplicara en cada pointerdown, un click con micro-movimiento
        // perdería el hit-test sobre el <button> y el lightbox no abriría. Se agrega
        // recién en moveDrag, cuando se confirma un drag real (didDrag).
        const point = e.touches ? e.touches[0] : e;
        pointerStartX = point.clientX;
        pointerStartY = point.clientY;
        dragStartTranslate = translateX;
        // Registrar los listeners de movimiento/fin solo durante un drag real. Un touchmove
        // no pasivo permanente en window bloquea el scroll de TODA la página en cada gesto.
        window.addEventListener('pointermove', moveDrag, { passive: false });
        window.addEventListener('touchmove', moveDrag, { passive: false });
        window.addEventListener('pointerup', endDrag);
        window.addEventListener('pointercancel', endDrag);
        window.addEventListener('touchend', endDrag);
      }

      function moveDrag(e) {
        if (!isDragging) return;
        const point = e.touches ? e.touches[0] : e;
        const dx = point.clientX - pointerStartX;
        const dy = point.clientY - pointerStartY;

        // Movimiento más vertical que horizontal: soltar para no romper el
        // scroll vertical de la página en mobile.
        if (!didDrag && Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
          endDrag();
          return;
        }
        if (!didDrag && Math.abs(dx) > 8) {
          // umbral alto: el jitter del click no cuenta como drag
          didDrag = true;
          marquee.classList.add('dragging'); // recién acá: cards a pointer-events:none + cursor grabbing
        }

        translateX = dragStartTranslate + dx;
        while (translateX <= -trackWidth) translateX += trackWidth;
        while (translateX > 0) translateX -= trackWidth;

        if (e.cancelable && didDrag) e.preventDefault();
      }

      function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        window.removeEventListener('pointermove', moveDrag);
        window.removeEventListener('touchmove', moveDrag);
        window.removeEventListener('pointerup', endDrag);
        window.removeEventListener('pointercancel', endDrag);
        window.removeEventListener('touchend', endDrag);
        marquee.classList.remove('dragging');
        // Tras un drag real, suprimir el próximo click (que abriría el lightbox).
        if (didDrag) {
          const suppressClick = (ev) => {
            ev.stopPropagation();
            ev.preventDefault();
          };
          window.addEventListener('click', suppressClick, { capture: true, once: true });
          // Cleanup forzado por si el click nunca llega a dispararse.
          window.setTimeout(() => {
            window.removeEventListener('click', suppressClick, { capture: true });
          }, 300);
        }
        didDrag = false; // CRÍTICO: resetear para que el próximo click no quede suprimido
      }

      marquee.addEventListener('mouseenter', () => { isHovering = true; });
      marquee.addEventListener('mouseleave', () => { isHovering = false; });

      marquee.addEventListener('pointerdown', startDrag);
      // Fallback touch (Safari iOS viejo sin Pointer Events).
      marquee.addEventListener('touchstart', startDrag, { passive: true });
      // Los listeners de pointermove/touchmove/pointerup/touchend se registran en startDrag
      // y se remueven en endDrag (no permanentes en window).

      requestAnimationFrame(() => {
        measure();
        rafId = requestAnimationFrame(tick);
      });
      window.addEventListener('resize', measure, { passive: true });

      // Pausar el rAF fuera de viewport (eficiencia).
      const visObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (!rafId) { lastTime = 0; rafId = requestAnimationFrame(tick); }
          } else if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
