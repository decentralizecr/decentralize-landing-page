  .testi-stars circle:nth-child(97)  { animation-delay: -2.1s; }
  .testi-stars circle:nth-child(109) { animation-delay: -2.9s; }
  .testi-stars circle:nth-child(115) { animation-delay: -3.7s; }

  /* Tanda 2.3: 4 pulsantes extra en la franja baja nueva (índices 123-132). */
  .testi-stars circle:nth-child(123),
  .testi-stars circle:nth-child(127),
  .testi-stars circle:nth-child(129),
  .testi-stars circle:nth-child(132) {
    animation: testiTwinkle 2.8s ease-in-out infinite;
  }
  .testi-stars circle:nth-child(123) { animation-delay: -0.7s; }
  .testi-stars circle:nth-child(127) { animation-delay: -1.5s; }
  .testi-stars circle:nth-child(129) { animation-delay: -2.3s; }
  .testi-stars circle:nth-child(132) { animation-delay: -1.1s; }

  /* Pop real: opacity + scale + glow al pico (50%), no solo fade. */
  @keyframes testiTwinkle {
    0%, 100% {
      opacity: 0.15;
      transform: scale(1);
      filter: drop-shadow(0 0 0 rgba(255,255,255,0));
    }
    50% {
      opacity: 1;
      transform: scale(1.6);
      filter: drop-shadow(0 0 2.5px rgba(255,255,255,0.9));
    }
  }
