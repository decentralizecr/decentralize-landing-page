---
// Sección 8 — Testimonios (upgrade espacial) · id="testimonios"
// Cards de testimonio como satélites a la deriva en un marquee infinito, sobre un
// fondo cósmico de 3 capas: nebulosa CSS + constelación SVG estática + meteoros
// en canvas (desktop y mobile). Lightbox para ver cada screenshot.
//
// Convenciones del repo (no del spec genérico):
//  - Sección autocontenida: <style> scoped + <script is:inline> IIFE.
//  - Reveal con clase local .testi-reveal + .visible, escalonado con --del.
//  - Imágenes en /testi-N.webp (public/), no /assets/images.
//  - Sin sections.ts/galaxy.ts/meteors.ts: factory de canvas inline + IO de pausa.
//  - Pixel diferido: hooks // TODO Pixel hasta que exista src/lib/pixel.ts.
const testimonios = [
  { src: '/testi-1.webp', rot: '-2deg',   floatDelay: '0s',    pill: 'Cliente desde 2022' },
  { src: '/testi-2.webp', rot: '1.5deg',  floatDelay: '-1.5s', pill: 'Cliente desde 2022' },
  { src: '/testi-3.webp', rot: '-1deg',   floatDelay: '-3s',   pill: 'Cliente desde 2022' },
  { src: '/testi-4.webp', rot: '2deg',    floatDelay: '-4.5s', pill: 'Cliente desde 2023' },
  { src: '/testi-5.webp', rot: '-1.5deg', floatDelay: '-6s',   pill: 'Cliente desde 2023' },
  { src: '/testi-6.webp', rot: '1deg',    floatDelay: '-7.5s', pill: 'Cliente desde 2024' },
];
// 6 cards + 6 duplicadas para el loop seamless del marquee (JS-driven transform).
const loop = [...testimonios, ...testimonios];
// Delay del glow pulsante por POSICIÓN (no por dato): 12 valores distintos para
// que ni las cards ni sus duplicados pulsen sincronizados.
const glowDelays = ['0s', '-1.2s', '-2.4s', '-0.6s', '-3.6s', '-1.8s',
                    '-2.7s', '-0.9s', '-3.3s', '-1.5s', '-2.1s', '-4.2s'];
---

