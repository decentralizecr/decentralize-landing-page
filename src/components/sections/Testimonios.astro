    </p>
  </div>

  <!-- Marquee full-bleed -->
  <div class="marquee testi-reveal" style="--del:.3s">
    <div class="track">
      {loop.map((t, i) => (
        <div
          class="testi-slide"
          style={`--rot:${t.rot};--float-delay:${t.floatDelay};--glow-delay:${glowDelays[i]}`}
        >
          <button
            class="testi-card"
            type="button"
            data-img={t.src}
            data-idx={i % testimonios.length}
            aria-label={`Ver testimonio ${(i % testimonios.length) + 1}`}
          >
            <img src={t.src} loading="lazy" fetchpriority="low" decoding="async"
                 alt={`Testimonio ${(i % testimonios.length) + 1}`} width="280" height="498" />
          </button>
          <span class="testi-pill">{t.pill}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="testi-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="testi-lb-content">
    <!-- La X, las flechas y la imagen van dentro de .testi-lb-figure: así las
