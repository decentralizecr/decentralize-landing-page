<style>
.trf {
  background: var(--bg-base);
  position: relative;
  z-index: 10;
  overflow: hidden;
}
.trf-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.trf .wrap {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* Eyebrow */
.trf-eyebrow {
  margin-bottom: 16px;
}

/* H2 */
.trf-h2 {
  font: 700 clamp(2rem, 4.5vw, 3.2rem)/1.15 var(--font-display);
  letter-spacing: -0.02em;
  color: var(--txt-hi);
  margin: 0 0 16px;
}
.accent { color: var(--btc); }

/* Sub */
.trf-sub {
  font: 400 1.05rem/1.7 var(--font-body);
  color: var(--txt-body);
  max-width: 520px;
  margin: 0 0 56px;
}

/* Grid */
.trf-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0 24px;
  align-items: stretch;
  max-width: 1000px;
  width: 100%;
  text-align: left;
}

@media (max-width: 768px) {
  .trf-grid {
    grid-template-columns: 1fr 1fr !important;
    gap: 10px !important;
    align-items: stretch;
  }
  .trf-card {
    padding: 16px 12px;
    gap: 14px;
  }
  .card-antes { order: 1; }
  .card-despues { order: 2; }
  .trf-energy { display: none !important; }
  .trf-card-header { font-size: 11px; letter-spacing: 2px; }
  .trf-item {
    font-size: 12px;
    gap: 8px;
  }
  .trf-icon {
    width: 15px;
    height: 15px;
  }
  .trf-sub { margin: 0 16px 32px; }
}

@keyframes dotTravelH {
  0%   { left: 0%; opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { left: 100%; opacity: 0; }
}

/* Cards */
.trf-card {
  border-radius: 20px;
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  height: 100%;
  box-sizing: border-box;
}
.card-antes {
  background: rgba(180,60,60,0.08);
  border: 1px solid rgba(180,60,60,0.45);
  box-shadow: 0 0 40px rgba(180,60,60,0.12), inset 0 0 60px rgba(180,60,60,0.04);
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
  cursor: default;
}
.card-antes:hover {
  border-color: rgba(180,60,60,0.8);
  box-shadow: 0 0 60px rgba(180,60,60,0.3), inset 0 0 80px rgba(180,60,60,0.1);
}
.card-despues {
  background: rgba(247,147,26,0.04);
  border: 1px solid rgba(247,147,26,0.35);
  box-shadow: 0 0 40px rgba(247,147,26,0.08);
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
  cursor: default;
}
.card-despues:hover {
  border-color: rgba(247,147,26,0.8);
  box-shadow: 0 0 60px rgba(247,147,26,0.3), inset 0 0 80px rgba(247,147,26,0.08);
}

/* Headers */
.trf-card-header {
  font: 400 13px/1 var(--font-mono);
  letter-spacing: 3px;
  margin: 0;
  text-align: center;
  width: 100%;
}
.card-antes .trf-card-header { color: #5A6270; }
.card-despues .trf-card-header { color: var(--btc); }

/* Items */
.trf-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  justify-content: space-between;
  flex: 1;
}
.trf-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font: 400 15px/1.5 var(--font-body);
  flex: 1;
  padding: 10px 0;
}
.card-antes .trf-item { color: #9BA3AF; }
.card-despues .trf-item { color: #E8ECF1; opacity: 0.25; }
.card-despues .trf-item.lit { opacity: 1; }
.card-despues .trf-item.flash span {
  text-shadow: 0 0 12px rgba(247,147,26,0.6);
}

/* Iconos */
.trf-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  margin-top: 2px;
}
.icon-x { color: var(--red-muted); }
.icon-check { color: var(--btc); }

/* Línea de energía desktop */
.trf-energy {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 200px;
}
.trf-energy-line {
  width: 2px;
  height: 80%;
  min-height: 200px;
  background: linear-gradient(to bottom, transparent, rgba(247,147,26,0.6), transparent);
  border-radius: 2px;
  position: relative;
  overflow: hidden;
}
.trf-energy-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--btc);
  box-shadow: 0 0 10px rgba(247,147,26,0.8);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  animation: dotTravel 2s ease-in-out infinite;
}
@keyframes dotTravel {
  0%   { top: 0%; opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

/* Reveal */
.trf-reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  transition-delay: var(--del, 0s);
}
.trf-reveal.visible {
  opacity: 1;
  transform: none;
}
@media (prefers-reduced-motion: reduce) {
  .trf-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  .trf-canvas { display: none; }
  .trf-energy-dot { animation: none; top: 50%; }
  .card-despues .trf-item { opacity: 1; }
}


</style>

<script is:inline>
(function () {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Reveals */
  const revEls = document.querySelectorAll('.trf-reveal');
  if (reduce) {
    revEls.forEach(el => el.classList.add('visible'));
  } else {
    const revObs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          revObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -20px 0px' });
    revEls.forEach(el => revObs.observe(el));
  }

  /* Encendido secuencial items DESPUÉS */
  if (!reduce) {
    const despues = document.querySelector('.card-despues');
    if (despues) {
      const items = despues.querySelectorAll('.trf-item');
      const itemObs = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          items.forEach((item, i) => {
            setTimeout(() => {
              item.classList.add('lit');
              item.classList.add('flash');
              setTimeout(() => item.classList.remove('flash'), 500);
            }, i * 250);
          });
          itemObs.unobserve(despues);
        });
      }, { threshold: 0.3 });
      itemObs.observe(despues);
    }
  }

  /* Canvas warp */
  if (!reduce) {
    const canvas = document.querySelector('.trf-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const isMobile = window.innerWidth < 768;
      const N = isMobile ? 80 : 180;
      let w, h, parts = [];

      function spawn() {
        const angle = Math.random() * Math.PI * 2;
        return { angle, dist: 10 + Math.random() * 40, base: 0.8 + Math.random() * 2.2 };
      }

      function resize() {
        w = canvas.offsetWidth;
        h = canvas.offsetHeight;
        canvas.width = w * Math.min(devicePixelRatio, 1.5);
        canvas.height = h * Math.min(devicePixelRatio, 1.5);
        ctx.scale(Math.min(devicePixelRatio, 1.5), Math.min(devicePixelRatio, 1.5));
        parts = Array.from({ length: N }, spawn);
      }

      let rafId = null;
      let running = false;

      function frame() {
        const cx = w * 0.5, cy = h * 0.42;
        ctx.clearRect(0, 0, w, h);
        for (const p of parts) {
          const right = Math.cos(p.angle) > 0;
          const speed = p.base * (right ? 1.8 : 0.7);
          p.dist += speed;
          const len = speed * 18;
          const x1 = cx + Math.cos(p.angle) * p.dist;
          const y1 = cy + Math.sin(p.angle) * p.dist;
          const x2 = cx + Math.cos(p.angle) * (p.dist + len);
          const y2 = cy + Math.sin(p.angle) * (p.dist + len);
          const a = Math.min(0.75, p.dist / 200);
          ctx.strokeStyle = right
            ? `rgba(247,147,26,${a})`
            : `rgba(200,80,80,${a * 0.9})`;
          ctx.lineWidth = right ? 1.8 : 1.4;
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.stroke();
          if (p.dist > Math.max(w, h) * 0.65) Object.assign(p, spawn());
        }
        rafId = requestAnimationFrame(frame);
      }

      resize();
      window.addEventListener('resize', resize, { passive: true });

      const canvasObs = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting && !running) {
            running = true;
            frame();
          } else if (!e.isIntersecting && running) {
            running = false;
            cancelAnimationFrame(rafId);
          }
        });
      }, { rootMargin: '200px' });
      canvasObs.observe(canvas);
    }
  }

})();
</script>
