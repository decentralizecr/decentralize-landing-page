---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImageAlt?: string;
}

const {
  title = 'Bitcoin Masterclass — Decentralize',
  description = 'Aprendé cómo funciona el dinero de verdad. 7 horas, un solo pago, acceso de por vida.',
  noindex = false,
  ogImageAlt = 'Bitcoin Masterclass de Decentralize: educación en Bitcoin desde Costa Rica.',
} = Astro.props;

// Dominio de producción (Cloudflare Pages). Canonical y og:url siempre absolutos a este dominio,
// nunca al host de preview/local. Se deriva la ruta de Astro.url y se normaliza la barra final.
const SITE = 'https://decentralizecr.com';
const OG_IMAGE = `${SITE}/og-image.jpg`;
let pathname = Astro.url.pathname;
if (pathname.length > 1 && pathname.endsWith('/')) pathname = pathname.slice(0, -1);
const canonical = SITE + pathname;

// Meta Pixel: snippet base oficial. Solo en producción; en local todo va por
// console.log vía src/lib/pixel.ts. Init + PageView automático. ID 871601738724161.
// El guard runtime evita inicializar fbq en localhost/127.0.0.1 y en previews de
// Cloudflare Pages (*.pages.dev), que se buildean con PROD=true. Solo corre en
// producción real (decentralizecr.com), alineado con detectIsLocal() de pixel.ts.
const PIXEL_BASE = `<script>
if(!/(^localhost$)|(^127\\.0\\.0\\.1$)|(\\.pages\\.dev$)/.test(location.hostname)){
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '871601738724161');
fbq('track', 'PageView');
}
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=871601738724161&ev=PageView&noscript=1" alt="" /></noscript>`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {import.meta.env.PROD && <Fragment set:html={PIXEL_BASE} />}
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content="es_CR" />
  <meta property="og:site_name" content="Decentralize" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={OG_IMAGE} />

  <!-- Iconos + theme (fondo oscuro) -->
  <meta name="theme-color" content="#070708" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon1.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <!-- apple-touch-icon.png regenerado a 180x180 con el logo de puntos Decentralize sobre fondo
       de marca (#070708). Reemplazó a la B naranja de Bitcoin vieja que móvil priorizaba. -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <slot name="head" />
  <!-- Fuentes self-host (subset latin, woff2). Elimina el render-blocking y los 2 orígenes de
       Google (fonts.googleapis + fonts.gstatic): la hoja ya no bloquea el paint del hero (LCP).
       Preload solo de las 2 críticas above-the-fold (Space Grotesk 700 del h1, Inter 400 del cuerpo);
       el resto de pesos cargan bajo demanda con font-display:swap. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-700.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400.woff2" crossorigin />
  <style is:inline>
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/space-grotesk-400.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/space-grotesk-500.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/space-grotesk-600.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/space-grotesk-700.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/inter-400.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/inter-500.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Inter';font-style:normal;font-weight:550;font-display:swap;src:url('/fonts/inter-550.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/inter-600.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/jetbrains-mono-400.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
    @font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/jetbrains-mono-500.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
  </style>
</head>
<body>
  <slot />
</body>
</html>
