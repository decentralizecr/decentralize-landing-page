  /* ---- Centrado de las tarjetas de resultado (éxito / error / confirmación) ---- */
  /* La .page alinea arriba por defecto (para el form largo y el widget alto). */
  /* Las tarjetas cortas de resultado se centran vertical y horizontalmente. */
  .result-card { align-self: center; }

  /* ---- Pantalla de agendar (widget Calendly): alta, alineada arriba ---- */
  .agendar-card {
    align-self: flex-start;
    max-width: 640px;
  }
  .agendar-head { margin-bottom: 4px; }
  .agendar-h1 { font-size: clamp(1.5rem, 5vw, 1.9rem); }
  .calendly-shell {
    margin-top: 22px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0d0d0d;
  }
  .calendly-inline-widget { width: 100%; }

  /* ---- Confirmación branded (tras agendar), arriba del widget ---- */
  .agendar-confirm { animation: confirm-in 0.4s ease both; }
  @keyframes confirm-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---- Móvil ---- */
  @media (max-width: 520px) {
    .page { padding: 20px 12px 40px; }
    .glass-card { border-radius: var(--r-card); }
    /* pills: siguen en una fila de 4 · opts: siguen lado a lado */
    .opt { padding: 16px 12px 14px; min-height: 156px; }
    .opt-sub { font-size: 0.76rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>

<!-- Puente procesado (type-checked): importa la función testeada y arma el envío
     al Worker (usa import.meta / fetch). El resto de la lógica de DOM vive en el
     <script is:inline> de abajo, que no se type-checkea (código vanilla aprobado en Etapa 1). -->
<script>
  import { buildFormPayload, type FormPayload } from '../lib/form-payload';

  const WORKER_URL = 'https://decentralize-form.decentralizecr.workers.dev';
  const isLocal = import.meta.env.DEV ||
    ['localhost', '127.0.0.1'].includes(location.hostname);

  async function submitForm(payload: FormPayload) {
    if (isLocal) {
      console.log('[MOCK] payload que se enviaría:', payload);
      await new Promise((r) => setTimeout(r, 800)); // simula latencia
      return { ok: true, mock: true };
    }
    const res = await fetch(WORKER_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('Worker respondió ' + res.status);
    return { ok: true };
  }

  (window as any).__decentralizeForm = { buildFormPayload, submitForm, isLocal };
</script>

<script is:inline>
(function () {
  const form = document.getElementById('empezar-form');
  if (!form) return;

  /* Slider: burbuja en vivo + track relleno naranja */
  const slider = document.getElementById('conocimiento');
  const bubble = document.getElementById('slider-bubble');
  function paintSlider() {
    const val = +slider.value;
    const pct = (val / 10) * 100;
    bubble.textContent = val + '/10';
    slider.style.background =
      'linear-gradient(to right, #F7931A 0%, #F7931A ' + pct + '%, ' +
      'rgba(255,255,255,0.12) ' + pct + '%, rgba(255,255,255,0.12) 100%)';
  }
  slider.addEventListener('input', paintSlider);
  paintSlider();

  const $ = id => document.getElementById(id);
  const nombre  = $('nombre');
  const email   = $('email');
  const telefono = $('telefono');
  const pais    = $('pais');
  const pillsBox = document.querySelector('.pills');
  const optsBox  = document.querySelector('.opts');
  const banner   = $('form-banner');
  const referidoField = $('referido-field');
  const referidoInput = $('referido-nombre');

  let comoSeEntero = '';
  let opcion = 'pago';
  let attempted = false; // los warnings solo aparecen tras intentar enviar

  /* ---- Parte C: restricción de tipo de input ---- */
  // Nombre y Referido: solo letras, espacios, tildes, ñ, apóstrofes y guiones.
  const soloTexto = el => el.addEventListener('input', () => {
    const clean = el.value.replace(/[^\p{L}\s'’\-]/gu, '');
    if (clean !== el.value) el.value = clean;
  });
  soloTexto(nombre);
  soloTexto(referidoInput);
  // Teléfono: solo dígitos y espacios.
  telefono.addEventListener('input', () => {
    const clean = telefono.value.replace(/[^\d\s]/g, '');
    if (clean !== telefono.value) telefono.value = clean;
  });

  /* ---- Parte B: validación ---- */
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setError(errId, msg, targets) {
    const err = $(errId);
    if (msg) {
      err.querySelector('.error-txt').textContent = msg;
      err.hidden = false;
      targets.forEach(t => t && t.classList.add('is-invalid'));
    } else {
      err.hidden = true;
      targets.forEach(t => t && t.classList.remove('is-invalid'));
    }
  }

  // Cada validador devuelve true/false y refresca su UI de error.
  const validators = {
    nombre() {
      const ok = nombre.value.trim().length > 0;
      setError('err-nombre', ok ? '' : 'Este campo es obligatorio', [nombre]);
      return ok;
    },
    email() {
      const v = email.value.trim();
      let msg = '';
      if (!v) msg = 'Este campo es obligatorio';
      else if (!emailRe.test(v)) msg = 'Ingresá un correo válido';
      setError('err-email', msg, [email]);
      return !msg;
    },
    telefono() {
      const ok = telefono.value.trim().length > 0;
      setError('err-telefono', ok ? '' : 'Este campo es obligatorio', [telefono]);
      return ok;
    },
    pais() {
      const ok = pais.value.trim().length > 0;
      setError('err-pais', ok ? '' : 'Este campo es obligatorio', [pais]);
      return ok;
    },
    como() {
      const ok = comoSeEntero !== '';
      const err = $('err-como');
      if (ok) { err.hidden = true; pillsBox.classList.remove('is-invalid'); }
      else { err.hidden = false; pillsBox.classList.add('is-invalid'); }
      return ok;
    },
    referido() {
      // solo requerido si la opción elegida es Referido
      if (comoSeEntero !== 'Referido') { setError('err-referido', '', [referidoInput]); return true; }
      const ok = referidoInput.value.trim().length > 0;
      setError('err-referido', ok ? '' : 'Este campo es obligatorio', [referidoInput]);
      return ok;
    },
    opcion() {
      const ok = opcion !== '';
      const err = $('err-opcion');
      if (ok) { err.hidden = true; optsBox.classList.remove('is-invalid'); }
      else { err.hidden = false; optsBox.classList.add('is-invalid'); }
      return ok;
    },
  };

  // Re-valida un campo solo si ya tenía error visible (para limpiarlo al corregir).
  function revalidate(name, errId) {
    if (!attempted) return;
    if ($(errId).hidden) return;
    validators[name]();
    if (!Object.values(errorIds).some(id => !$(id).hidden)) banner.hidden = true;
  }
  const errorIds = {
    nombre: 'err-nombre', email: 'err-email', telefono: 'err-telefono',
    pais: 'err-pais', como: 'err-como', referido: 'err-referido', opcion: 'err-opcion',
  };

  // Limpieza en vivo al corregir
  nombre.addEventListener('input', () => revalidate('nombre', 'err-nombre'));
  email.addEventListener('input', () => revalidate('email', 'err-email'));
  telefono.addEventListener('input', () => revalidate('telefono', 'err-telefono'));
  pais.addEventListener('change', () => revalidate('pais', 'err-pais'));
  referidoInput.addEventListener('input', () => revalidate('referido', 'err-referido'));

  /* Pills: selección única + campo Referido condicional */
  const pills = Array.from(document.querySelectorAll('.pill'));
  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => { p.classList.remove('is-active'); p.setAttribute('aria-checked', 'false'); });
      pill.classList.add('is-active');
      pill.setAttribute('aria-checked', 'true');
      comoSeEntero = pill.dataset.value;

      if (comoSeEntero === 'Referido') {
        referidoField.hidden = false;
      } else {
        referidoField.hidden = true;
        referidoInput.value = ''; // se limpia al elegir otra opción
        setError('err-referido', '', [referidoInput]); // y su warning
      }
      revalidate('como', 'err-como');
      revalidate('referido', 'err-referido');
    });
  });

  /* Opciones (cards): selección única, 'pago' por defecto */
  const opts = Array.from(document.querySelectorAll('.opt'));
  opts.forEach(opt => {
    opt.addEventListener('click', () => {
      opts.forEach(o => { o.classList.remove('is-active'); o.setAttribute('aria-checked', 'false'); });
      opt.classList.add('is-active');
      opt.setAttribute('aria-checked', 'true');
      opcion = opt.dataset.value;
      revalidate('opcion', 'err-opcion');
    });
  });

  /* Liquid glass: blob al mover el puntero sobre el submit */
  const submit = form.querySelector('.submit');
  submit.addEventListener('pointermove', e => {
    const r = submit.getBoundingClientRect();
    submit.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    submit.style.setProperty('--my', (e.clientY - r.top) + 'px');
  });

  /* ---- Transición cross-fade entre tarjetas ---- */
  const formCard = $('form-card');
  const submitBtn = $('submit-btn');
  const submitText = submitBtn.querySelector('.submit-t');
  const submitSpinner = submitBtn.querySelector('.submit-spinner');
  const retryBtn = $('retry-btn');

  function setLoading(on) {
    if (on) {
      submitBtn.classList.add('is-loading');
      submitBtn.disabled = true;
      submitSpinner.hidden = false;
      submitText.textContent = 'Enviando...';
    } else {
      submitBtn.classList.remove('is-loading');
      submitBtn.disabled = false;
      submitSpinner.hidden = true;
      submitText.textContent = 'Enviar inscripción →';
    }
  }

  // Oculta la tarjeta visible con fade y muestra la de destino con fade-in.
  // SIEMPRE vuelve al tope de la página (bug histórico del landing viejo).
  function crossFade(fromEl, toEl, onShown) {
    fromEl.classList.add('fade-out');
    setTimeout(() => {
      fromEl.hidden = true;
      fromEl.classList.remove('fade-out');
      window.scrollTo(0, 0);
      toEl.hidden = false;
      toEl.classList.add('fade-in-start');
      requestAnimationFrame(() => requestAnimationFrame(() => {
        toEl.classList.remove('fade-in-start');
        if (typeof onShown === 'function') onShown();
      }));
    }, 400);
  }

  const primerNombre = () => (nombre.value.trim().split(/\s+/)[0] || '');

  /* ---- Calendly: carga diferida del script, una sola vez ---- */
  const CALENDLY_SRC = 'https://assets.calendly.com/assets/external/widget.js';
  let calendlyRequested = false;
  function ensureCalendly() {
    if (calendlyRequested) return;           // guard: no reinyectar
    calendlyRequested = true;
    if (document.querySelector('script[src="' + CALENDLY_SRC + '"]')) return; // ya existe
    const s = document.createElement('script');
    s.src = CALENDLY_SRC;
    s.async = true;
    document.head.appendChild(s);
    // TODO(pixel): track('CalendlyVisto') cuando se cablee la etapa de píxeles.
  }

  /* ---- Camino llamada: pantalla de agendar con widget Calendly ---- */
  const agendarCard = $('agendar-card');

  function showAgendar() {
    $('agendar-nombre').textContent = primerNombre();
    crossFade(formCard, agendarCard, () => {
      ensureCalendly();          // el script se inyecta recién acá (no en el load)
    });
  }

  // Al agendar: NO se desmonta el widget. Solo se reemplaza el encabezado de arriba
  // por la tarjeta de confirmación branded; el detalle de la cita queda visible debajo.
  let confirmadaShown = false;
  function mostrarLlamadaConfirmada() {
    if (confirmadaShown) return; // evitar doble transición
    confirmadaShown = true;
    $('confirmada-nombre').textContent = primerNombre();
    $('agendar-head').hidden = true;
    $('agendar-confirm').hidden = false;
    window.scrollTo(0, 0); // se ve primero la confirmación; el widget queda scrolleando abajo
    // TODO(pixel): track('Schedule') / Purchase-equivalente al cablear píxeles.
  }

  /* Detección de cita agendada vía postMessage de Calendly. */
  function isCalendlyEvent(e) {
    return e.data && typeof e.data.event === 'string' && e.data.event.indexOf('calendly') === 0;
  }
  window.addEventListener('message', (e) => {
    if (isCalendlyEvent(e) && e.data.event === 'calendly.event_scheduled') {
      mostrarLlamadaConfirmada();
    }
  });

  function showSuccess(op) {
    if (op === 'llamada') {
      showAgendar();
    } else {
      $('success-nombre').textContent = primerNombre();
      $('success-email').textContent = email.value.trim();
      crossFade(formCard, $('success-pago'));
    }
  }

  /* Submit: valida todo. Si falta algo, muestra warnings y NO envía. */
  form.addEventListener('submit', async e => {
    e.preventDefault();
    attempted = true;

    const results = [
      validators.nombre(), validators.email(), validators.telefono(),
      validators.pais(), validators.como(), validators.referido(), validators.opcion(),
    ];
    const allValid = results.every(Boolean);
    banner.hidden = allValid;
    if (!allValid) return; // hay errores: no se envía

    // buildFormPayload y submitForm vienen del <script> puente (módulo diferido).
    const bridge = window.__decentralizeForm;
    const payload = bridge.buildFormPayload({
      nombre: nombre.value,
      email: email.value,
      codigo: $('codigo').value,
      numero: telefono.value,
      pais: pais.value,
      conocimiento: slider.value,
      comoSeEntero: comoSeEntero,
      referido: referidoInput.value,
      opcion: opcion,
    });

    setLoading(true);
    try {
      await bridge.submitForm(payload);
      setLoading(false);
      showSuccess(payload.opcion);
    } catch (err) {
      console.error('[submit] fallo el envío:', err);
      setLoading(false);
      crossFade(formCard, $('error-card'));
    }
  });

  /* Reintentar: vuelve al formulario con los datos intactos. */
  retryBtn.addEventListener('click', () => {
    crossFade($('error-card'), formCard);
  });
})();
</script>
