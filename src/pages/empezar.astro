---
// Página /empezar — formulario de inscripción al Bitcoin Masterclass.
// ETAPA 1: solo shell visual + interacción de UI. Sin envío real todavía.
// Fondo: globo compartido (GlobeBackground). Form sobre tarjeta liquid glass
// al estilo de la Sección 2 (El Problema). NO se indexa.
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobeBackground from '../components/GlobeBackground.astro';

const codigos = [
  { code: '+506', pais: 'CR' },
  { code: '+52',  pais: 'MX' },
  { code: '+57',  pais: 'CO' },
  { code: '+54',  pais: 'AR' },
  { code: '+56',  pais: 'CL' },
  { code: '+51',  pais: 'PE' },
  { code: '+593', pais: 'EC' },
  { code: '+58',  pais: 'VE' },
  { code: '+502', pais: 'GT' },
  { code: '+503', pais: 'SV' },
  { code: '+504', pais: 'HN' },
  { code: '+505', pais: 'NI' },
  { code: '+507', pais: 'PA' },
  { code: '+591', pais: 'BO' },
  { code: '+595', pais: 'PY' },
  { code: '+598', pais: 'UY' },
  { code: '+1',   pais: 'DO' },
];

const paises = [
  'Costa Rica', 'México', 'Guatemala', 'El Salvador', 'Honduras', 'Nicaragua',
  'Panamá', 'Colombia', 'Venezuela', 'Ecuador', 'Perú', 'Bolivia', 'Chile',
  'Argentina', 'Paraguay', 'Uruguay', 'República Dominicana', 'Otro',
];
---
<BaseLayout title="Empezá tu camino con Bitcoin | Decentralize" noindex={true}>
  <GlobeBackground />

  <main class="page">
    <section class="glass-card" id="form-card">
      <header class="card-head">
        <p class="eyebrow-orange">Bitcoin Masterclass</p>
        <h1 class="card-h1">Empezá tu camino con <span class="orange">Bitcoin.</span></h1>
        <p class="card-sub">Completá el formulario. Te contactamos de inmediato.</p>
      </header>

      <form id="empezar-form" class="form" novalidate>
        <!-- Nombre -->
        <div class="field">
          <label for="nombre">Nombre completo</label>
          <input type="text" id="nombre" name="nombre" placeholder="Tu nombre completo" autocomplete="name" aria-describedby="err-nombre" />
          <p class="error-msg" id="err-nombre" hidden><svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="error-txt">Este campo es obligatorio</span></p>
        </div>

        <!-- Email -->
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" inputmode="email" placeholder="tu@correo.com" autocomplete="email" aria-describedby="err-email" />
          <p class="error-msg" id="err-email" hidden><svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="error-txt">Este campo es obligatorio</span></p>
        </div>

        <!-- Teléfono -->
        <div class="field">
          <label for="telefono">Teléfono</label>
          <div class="phone">
            <select id="codigo" class="phone-code" aria-label="Código de país">
              {codigos.map(c => (
                <option value={c.code} selected={c.code === '+506'}>{c.code} {c.pais}</option>
              ))}
            </select>
            <input type="tel" id="telefono" name="telefono" inputmode="numeric" placeholder="88888888" autocomplete="tel-national" aria-describedby="err-telefono" />
          </div>
          <p class="error-msg" id="err-telefono" hidden><svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="error-txt">Este campo es obligatorio</span></p>
        </div>

        <!-- País -->
        <div class="field">
          <label for="pais">País</label>
          <select id="pais" name="pais" class="select" aria-describedby="err-pais">
            {paises.map(p => (
              <option value={p} selected={p === 'Costa Rica'}>{p}</option>
            ))}
          </select>
          <p class="error-msg" id="err-pais" hidden><svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="error-txt">Este campo es obligatorio</span></p>
        </div>

        <!-- Conocimiento -->
        <div class="field">
          <label for="conocimiento">¿Cuánto sabés de Bitcoin? <span class="hint">0 = nada, 10 = experto</span></label>
          <div class="slider-wrap">
            <input type="range" id="conocimiento" name="conocimiento" min="0" max="10" step="1" value="5" />
            <output class="slider-bubble" id="slider-bubble" for="conocimiento">5/10</output>
          </div>
        </div>

        <!-- Cómo se enteró -->
        <div class="field">
          <label>¿Cómo te enteraste?</label>
          <div class="pills" role="radiogroup" aria-label="¿Cómo te enteraste?">
            <button type="button" class="pill" data-value="Instagram" role="radio" aria-checked="false" aria-label="Instagram" title="Instagram">
              <svg class="ico ico-brand" viewBox="0 0 24 24" aria-hidden="true">
                <defs>
                  <linearGradient id="ig-grad" x1="0" y1="1" x2="1" y2="0">
                    <stop offset="0" stop-color="#feda75"/>
                    <stop offset="0.25" stop-color="#fa7e1e"/>
                    <stop offset="0.5" stop-color="#d62976"/>
                    <stop offset="0.75" stop-color="#962fbf"/>
                    <stop offset="1" stop-color="#4f5bd5"/>
                  </linearGradient>
                </defs>
                <path fill="url(#ig-grad)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </button>
            <button type="button" class="pill" data-value="Facebook" role="radio" aria-checked="false" aria-label="Facebook" title="Facebook">
              <svg class="ico ico-brand" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </button>
            <button type="button" class="pill" data-value="TikTok" role="radio" aria-checked="false" aria-label="TikTok" title="TikTok">
              <svg class="ico ico-brand" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#25F4EE" transform="translate(-1,-1)" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                <path fill="#FE2C55" transform="translate(1,1)" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                <path fill="#FFFFFF" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </button>
            <button type="button" class="pill" data-value="Referido" role="radio" aria-checked="false" aria-label="Referido" title="Referido">
              <svg class="ico ico-user" viewBox="0 0 24 24" fill="none" stroke="#E5E7EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </button>
          </div>
          <p class="error-msg" id="err-como" hidden><svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="error-txt">Este campo es obligatorio</span></p>
        </div>

        <!-- Nombre de quien refirió (solo visible al elegir Referido) -->
        <div class="field referido-field" id="referido-field" hidden>
          <label for="referido-nombre">¿Quién te refirió?</label>
          <input type="text" id="referido-nombre" name="referido-nombre" placeholder="Nombre de quien te refirió" autocomplete="off" aria-describedby="err-referido" />
          <p class="error-msg" id="err-referido" hidden><svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="error-txt">Este campo es obligatorio</span></p>
        </div>

        <!-- Cómo continuar -->
        <div class="field">
          <label>¿Cómo querés continuar?</label>
          <div class="opts" role="radiogroup" aria-label="¿Cómo querés continuar?">
            <button type="button" class="opt" data-value="llamada" role="radio" aria-checked="false">
              <span class="opt-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="opt-icon opt-icon--phone" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <span class="opt-title">Quiero una llamada gratis</span>
              <span class="opt-sub">30 min con Alberto para resolver tus dudas.</span>
            </button>
            <button type="button" class="opt is-active" data-value="pago" role="radio" aria-checked="true">
              <span class="opt-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="opt-icon opt-icon--check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="opt-title">Estoy listo para empezar</span>
              <span class="opt-sub">Enviame los métodos de pago por correo.</span>
            </button>
          </div>
          <p class="error-msg" id="err-opcion" hidden><svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span class="error-txt">Este campo es obligatorio</span></p>
        </div>

        <!-- Banner de error global -->
        <div class="form-banner" id="form-banner" role="alert" hidden>
          <svg class="error-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>Por favor completá todos los campos antes de continuar.</span>
        </div>

        <!-- Submit -->
        <button type="submit" class="submit" id="submit-btn">
          <span class="submit-liquid" aria-hidden="true"></span>
          <span class="submit-spinner" aria-hidden="true" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          </span>
          <span class="submit-t">Enviar inscripción →</span>
        </button>
      </form>
    </section>

    <!-- ============ Pantalla de éxito · camino PAGO ============ -->
    <section class="glass-card result-card" id="success-pago" hidden>
      <div class="result-inner">
        <div class="btc-badge">
          <svg class="btc-logo" viewBox="0 0 4091 4091" role="img" aria-label="Bitcoin">
            <circle cx="2045.63" cy="2045.63" r="2045.63" fill="#F7931A"/>
            <path fill="#FFFFFF" d="M2947.77,1754.38c40.72,-272.26 -166.56,-418.61 -450,-516.24l91.95,-368.8l-224.5,-55.94l-89.51,359.09c-59.02,-14.72 -119.63,-28.59 -179.87,-42.34l90.16,-361.46l-224.36,-55.94l-92,368.68c-48.84,-11.12 -96.81,-22.11 -143.35,-33.69l0.26,-1.16l-309.59,-77.31l-59.72,239.78c0,0 166.56,38.18 163.05,40.53c90.91,22.69 107.35,82.87 104.62,130.57l-104.74,420.15c6.26,1.59 14.38,3.89 23.34,7.49c-7.49,-1.86 -15.46,-3.89 -23.73,-5.87l-146.81,588.57c-11.11,27.62 -39.31,69.07 -102.87,53.33c2.25,3.26 -163.17,-40.72 -163.17,-40.72l-111.46,256.98l292.15,72.83c54.35,13.63 107.61,27.89 160.06,41.3l-92.9,373.03l224.24,55.94l92,-369.07c61.26,16.63 120.71,31.97 178.91,46.43l-91.69,367.33l224.51,55.94l92.89,-372.33c382.82,72.44 670.67,43.24 791.83,-303.02c97.63,-278.78 -4.86,-439.58 -206.26,-544.44c146.69,-33.83 257.18,-130.31 286.64,-329.61Zm-512.93,719.26c-69.38,278.78 -538.76,128.08 -690.94,90.29l123.28,-494.2c152.17,37.99 640.17,113.17 567.66,403.91Zm69.43,-723.3c-63.29,253.58 -453.96,124.75 -580.69,93.16l111.77,-448.21c126.73,31.59 534.85,90.55 468.92,355.05Z"/>
          </svg>
          <span class="check-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline class="check-path" points="20 6 9 17 4 12"/></svg>
          </span>
        </div>
        <h2 class="result-h">¡Listo, <span id="success-nombre">crack</span>!</h2>
        <p class="result-body">Te enviamos los métodos de pago del Masterclass a <span class="result-strong" id="success-email">tu correo</span>. Si no lo ves en 5 minutos, revisá la carpeta de spam.</p>
        <p class="result-muted">Ya podés cerrar esta página.</p>
        <a class="result-link" href="https://ig.me/m/decentralizecr" target="_blank" rel="noopener">¿Tenés dudas? Escribime por Instagram →</a>
      </div>
    </section>

    <!-- ============ Pantalla de agendar · camino LLAMADA (widget Calendly) ============ -->
    <!-- No se centra vertical (es alta): va alineada arriba con scrollTo(0,0). -->
    <section class="glass-card agendar-card" id="agendar-card" hidden>
      <!-- Encabezado inicial (antes de agendar) -->
      <header class="card-head agendar-head" id="agendar-head">
        <h2 class="card-h1 agendar-h1">Agendá tu llamada gratis, <span class="orange" id="agendar-nombre">crack</span></h2>
        <p class="card-sub">Elegí el día y la hora que mejor te queden. Son 30 minutos con Alberto, sin costo.</p>
      </header>

      <!-- Confirmación branded (tras agendar): reemplaza al encabezado, arriba del widget.
           El widget de Calendly NO se desmonta: queda debajo con el detalle de la cita. -->
      <div class="agendar-confirm" id="agendar-confirm" hidden>
        <div class="result-inner">
          <div class="btc-badge">
            <svg class="btc-logo" viewBox="0 0 4091 4091" role="img" aria-label="Bitcoin">
              <circle cx="2045.63" cy="2045.63" r="2045.63" fill="#F7931A"/>
